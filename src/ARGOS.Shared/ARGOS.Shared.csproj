<Project Sdk="Microsoft.NET.Sdk">
  <!-- Contrats échangés entre le serveur ARGOS et l'application (toutes plateformes). -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyName>ARGOS.Shared</AssemblyName>
    <RootNamespace>Argos.Shared</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- Natures d'intervention BSPP (codes et libellés), partagées par le serveur et l'application. -->
    <EmbeddedResource Include="Data\natures.json" LogicalName="ARGOS.natures.json" />
  </ItemGroup>
</Project>
