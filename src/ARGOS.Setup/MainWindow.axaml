<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Argos.Setup.MainWindow"
        Title="ARGOS - Installation"
        Width="700" Height="500" CanResize="False"
        WindowStartupLocation="CenterScreen"
        Icon="avares://ARGOS-Setup/Assets/argos-icon.png"
        Background="White" FontFamily="Segoe UI, Inter">
  <Window.Styles>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#0B2E59" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="Padding" Value="14,8" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#16437E" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.secondary">
      <Setter Property="Background" Value="#F2F4F7" />
      <Setter Property="BorderBrush" Value="#C9D0DA" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="Padding" Value="14,8" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="CornerRadius" Value="0" />
    </Style>
  </Window.Styles>

  <Grid ColumnDefinitions="250,*">
    <!-- Bandeau gauche, comme l'installateur de SIMCALL -->
    <Border Grid.Column="0" Background="#0B1A2E">
      <Grid Margin="28" RowDefinitions="Auto,*,Auto">
        <TextBlock Text="VAL-DE-MARNE&#x0a;SIMULATION" Foreground="#8FA3BF" FontSize="11" FontWeight="Bold" LetterSpacing="1.5" />
        <StackPanel Grid.Row="1" VerticalAlignment="Center">
          <Border Width="108" Height="108" HorizontalAlignment="Left" Background="#13294A" BorderBrush="#25406A" BorderThickness="1" Padding="10">
            <Image Source="avares://ARGOS-Setup/Assets/argos-icon.png" Stretch="Uniform" />
          </Border>
          <TextBlock Text="ARGOS" Foreground="White" FontSize="31" FontWeight="SemiBold" Margin="0,18,0,0" />
          <TextBlock Text="Poste de travail BSPP" Foreground="#A9B8CC" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0" />
          <TextBlock x:Name="VersionText" Text="Installation" Foreground="#E3262B" FontSize="11" FontWeight="SemiBold" Margin="0,13,0,0" />
        </StackPanel>
        <TextBlock Grid.Row="2" Text="ADAGIO · SIGTAO · eFIBI · ILIAS · MCO" Foreground="#5F7493" FontSize="9" FontWeight="Bold" TextWrapping="Wrap" />
      </Grid>
    </Border>

    <!-- Installation -->
    <Grid x:Name="InstallPanel" Grid.Column="1" Margin="32,30,32,28" RowDefinitions="Auto,24,Auto,18,Auto,*,Auto,18,Auto">
      <StackPanel Grid.Row="0">
        <TextBlock x:Name="TitleText" Text="Installer ARGOS" FontSize="24" FontWeight="SemiBold" Foreground="#0B1A2E" />
        <TextBlock x:Name="SubtitleText" FontSize="11" Foreground="#667085" TextWrapping="Wrap" Margin="0,7,0,0"
                   Text="ARGOS se met ensuite à jour tout seul depuis le serveur ARGOS. Votre session et vos réglages sont conservés." />
      </StackPanel>

      <StackPanel Grid.Row="2">
        <TextBlock Text="DOSSIER D'INSTALLATION" FontSize="9.5" FontWeight="Bold" Foreground="#7A8699" Margin="0,0,0,7" />
        <Grid ColumnDefinitions="*,Auto">
          <TextBox x:Name="InstallPathBox" Height="36" VerticalContentAlignment="Center" />
          <Button x:Name="BrowseButton" Grid.Column="1" Classes="secondary" Content="Parcourir" Margin="6,0,0,0" Height="36" />
        </Grid>
        <TextBlock Text="Dossier de l'utilisateur : aucune demande de droits Administrateur, mises à jour automatiques possibles."
                   FontSize="10" Foreground="#8A94A6" Margin="0,7,0,0" TextWrapping="Wrap" />
      </StackPanel>

      <StackPanel Grid.Row="4" Spacing="6">
        <CheckBox x:Name="DesktopShortcutBox" Content="Créer un raccourci ARGOS sur le Bureau" IsChecked="True" />
        <CheckBox x:Name="StartMenuShortcutBox" Content="Ajouter ARGOS au menu Démarrer" IsChecked="True" />
        <CheckBox x:Name="LaunchBox" Content="Lancer ARGOS à la fin de l'installation" IsChecked="True" />
      </StackPanel>

      <Border Grid.Row="6" Background="#F4F6F9" BorderBrush="#E1E6ED" BorderThickness="1" Padding="13,11">
        <StackPanel>
          <ProgressBar x:Name="Progress" Height="5" MinHeight="5" Minimum="0" Maximum="100" Value="0" Foreground="#E3262B" Background="#E1E6ED" CornerRadius="0" />
          <TextBlock x:Name="StatusText" Text="Prêt à installer ARGOS." Foreground="#4A5568" FontSize="10.5" Margin="0,8,0,0" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
        <Button x:Name="CancelButton" Classes="secondary" Content="Annuler" Width="100" />
        <Button x:Name="InstallButton" Classes="primary" Content="Installer" Width="130" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>
