<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Argos.Views"
             x:Class="Argos.Views.ShellView"
             FontFamily="{StaticResource WindowsFont}"
             Background="Black"
             Focusable="True">
    <UserControl.Styles>
        <!-- Fond flouté et légèrement agrandi (évite les bords transparents du flou), comme l'écran de connexion de Windows 10. -->
        <Style Selector="Image.wallpaper">
            <Setter Property="Transitions">
                <Transitions><DoubleTransition Property="Opacity" Duration="0:0:2" Easing="SineEaseInOut"/></Transitions>
            </Setter>
        </Style>
        <Style Selector="Image.wallpaper.blurred">
            <Setter Property="Effect">
                <BlurEffect Radius="48"/>
            </Setter>
            <Setter Property="RenderTransform" Value="scale(1.08)"/>
        </Style>
    </UserControl.Styles>

    <Grid ClipToBounds="True">
        <!-- Diaporama : deux calques, la nouvelle photo apparaît en fondu (2 s). -->
        <Image Classes="wallpaper" Source="{Binding WallpaperB}" Stretch="UniformToFill"
               Opacity="{Binding ShowWallpaperB, Converter={x:Static views:ShellConverters.Opacity}}"
               Classes.blurred="{Binding IsWallpaperBlurred}"/>
        <Image Classes="wallpaper" Source="{Binding WallpaperA}" Stretch="UniformToFill"
               Opacity="{Binding ShowWallpaperA, Converter={x:Static views:ShellConverters.Opacity}}"
               Classes.blurred="{Binding IsWallpaperBlurred}"/>

        <!-- Contenu, à l'intérieur des zones sûres (encoche, barre d'accueil) sur téléphone et tablette.
             Taille du texte et des applications (Paramètres › Affichage) : mise à l'échelle de tout l'écran. -->
        <LayoutTransformControl>
            <LayoutTransformControl.LayoutTransform>
                <ScaleTransform ScaleX="{Binding DisplayScale}" ScaleY="{Binding DisplayScale}"/>
            </LayoutTransformControl.LayoutTransform>
        <Panel Name="SafeArea">
            <views:LockScreenView IsVisible="{Binding IsLockScreen}"/>
            <views:LoginView IsVisible="{Binding IsLoginScreen}"/>
            <views:WelcomeView IsVisible="{Binding IsWelcomeScreen}"/>

            <Panel IsVisible="{Binding ShowDesktopLayout}">
                <views:DesktopView DataContext="{Binding Desktop}"/>
            </Panel>
            <Panel IsVisible="{Binding ShowMobileLayout}">
                <views:MobileHomeView DataContext="{Binding Desktop}"/>
            </Panel>
        </Panel>
        </LayoutTransformControl>

        <!-- Éclairage nocturne (Paramètres › Affichage) -->
        <Border Background="#FF8C00" Opacity="0.13" IsHitTestVisible="False" IsVisible="{Binding NightLight}"/>

        <!-- ===== Démarrage UEFI ===== -->
        <Border Background="Black" IsVisible="{Binding IsBootScreen}" PointerPressed="OnBootPressed">
            <Panel>
                <StackPanel Margin="48,40" Spacing="6" IsVisible="{Binding !BootLoadingWindows}">
                    <ItemsControl ItemsSource="{Binding BootLines}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="170,*" Margin="0,3">
                                    <TextBlock Text="{Binding Label}" Foreground="#E0E0E0" FontFamily="Consolas, Menlo, Liberation Mono, monospace" FontSize="15"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Value}" Foreground="#9FE59F" FontFamily="Consolas, Menlo, Liberation Mono, monospace"
                                               FontSize="15" IsVisible="{Binding HasValue}" TextWrapping="Wrap"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding BootProgress}" Height="6" Width="320" HorizontalAlignment="Left"
                                 Foreground="#9FE59F" Background="#222222" Margin="0,14,0,0"/>
                    <TextBlock Text="Appuyez sur une touche ou cliquez pour passer" Foreground="#777777" FontSize="12" Margin="0,8,0,0"
                               FontFamily="Consolas, Menlo, Liberation Mono, monospace"/>
                </StackPanel>
                <StackPanel IsVisible="{Binding BootLoadingWindows}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="60">
                    <PathIcon Data="{StaticResource IconWindows}" Width="110" Height="110" Foreground="#0A84D8"/>
                    <ProgressBar IsIndeterminate="True" Width="80" Height="4" Foreground="White" Background="Transparent"/>
                </StackPanel>
            </Panel>
        </Border>
    </Grid>
</UserControl>
