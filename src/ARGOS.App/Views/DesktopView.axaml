<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Argos.ViewModels"
             x:Class="Argos.Views.DesktopView">
    <UserControl.Styles>
        <Style Selector="TextBlock.iconlabel">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="MaxLines" Value="2"/>
            <Setter Property="Effect">
                <DropShadowEffect BlurRadius="4" OffsetX="1" OffsetY="1" Opacity="0.9" Color="Black"/>
            </Setter>
        </Style>
        <Style Selector="PathIcon.offline">
            <Setter Property="Opacity" Value="0.35"/>
        </Style>
        <Style Selector="TextBlock.white">
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="ToggleButton.quick, Button.quick">
            <Setter Property="Background" Value="#3A3A3A"/><Setter Property="Foreground" Value="White"/><Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Margin" Value="2"/><Setter Property="Height" Value="62"/><Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="VerticalContentAlignment" Value="Top"/><Setter Property="Padding" Value="8"/>
        </Style>
        <Style Selector="ToggleButton.quick:checked /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#0078D7"/><Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="ToggleButton.quick PathIcon"><Setter Property="Foreground" Value="White"/></Style>
    </UserControl.Styles>

    <Grid RowDefinitions="*,40">

        <!-- ===================== Zone de travail ===================== -->
        <Panel Name="WorkArea">
            <!-- Fond cliquable : ferme le menu Démarrer, désélectionne les icônes. -->
            <Border Name="Backdrop" Background="Transparent"/>

            <!-- Icônes du bureau, en colonnes depuis le coin supérieur gauche (comme Windows). -->
            <ItemsControl Name="DesktopIcons" ItemsSource="{Binding DesktopApps}" Margin="2,4,0,0"
                          HorizontalAlignment="Left" VerticalAlignment="Top">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Vertical"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Classes="desktopicon"
                                Classes.selected="{Binding IsSelected}"
                                Width="78" Height="90" Margin="2"
                                ToolTip.Tip="{Binding Subtitle}">
                            <StackPanel Spacing="3" Margin="2,6,2,0">
                                <Image Source="{Binding Icon}" Width="48" Height="48"
                                       RenderOptions.BitmapInterpolationMode="HighQuality"/>
                                <TextBlock Classes="iconlabel" Text="{Binding Title}"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Fenêtres ouvertes (gérées par le code de la vue). -->
            <Canvas Name="WindowLayer"/>

            <!-- Notifications, coin inférieur droit. -->
            <ItemsControl ItemsSource="{Binding Toasts}"
                          HorizontalAlignment="Right" VerticalAlignment="Bottom"
                          Margin="0,0,12,12" Width="364">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="8"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource StartMenuBrush}" Padding="16,12,8,14"
                                BoxShadow="0 4 16 0 #66000000">
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Image Source="{Binding Icon}" Width="16" Height="16" IsVisible="{Binding HasIcon}"/>
                                    <TextBlock Classes="white" Text="ARGOS" FontSize="12" Opacity="0.8"/>
                                </StackPanel>
                                <Button Grid.Column="1" Classes="flat tray" Height="24" Width="24"
                                        Command="{Binding DismissCommand}" ToolTip.Tip="Fermer">
                                    <Path Data="{StaticResource CaptionClose}" Stroke="White" StrokeThickness="1"
                                          Width="10" Height="10"/>
                                </Button>
                                <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Classes="white" Text="{Binding Title}"
                                           FontSize="15" FontWeight="SemiBold" Margin="0,8,0,2" TextWrapping="Wrap"/>
                                <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding Text}"
                                           Foreground="#CCCCCC" FontSize="14" TextWrapping="Wrap"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ===================== Vue des tâches ===================== -->
            <Border IsVisible="{Binding IsTaskViewOpen}" Background="#B3101010" PointerPressed="OnTaskViewBackgroundPressed">
                <DockPanel Margin="40,30">
                    <TextBlock DockPanel.Dock="Top" Text="Affichage des tâches" Foreground="White" FontSize="20" FontWeight="Light" Margin="0,0,0,20"/>
                    <Panel>
                        <TextBlock Text="Aucune application ouverte." Foreground="#CCCCCC" FontSize="14" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" IsVisible="{Binding !HasWindows}"/>
                        <ScrollViewer>
                            <ItemsControl ItemsSource="{Binding Windows}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel HorizontalAlignment="Center"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Classes="flat" Width="280" Height="190" Margin="12" Padding="0" Background="#2B2B2B"
                                                Command="{Binding $parent[UserControl].DataContext.TaskViewSelectCommand}" CommandParameter="{Binding}">
                                            <Grid RowDefinitions="34,*">
                                                <Grid ColumnDefinitions="Auto,*,Auto" Margin="10,0,4,0">
                                                    <Image Source="{Binding Icon}" Width="18" Height="18" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Classes="white" Text="{Binding Title}" FontSize="12.5" Margin="8,0"
                                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                    <Button Grid.Column="2" Classes="flat tray" Width="28" Height="28" ToolTip.Tip="Fermer"
                                                            Command="{Binding $parent[UserControl].DataContext.TaskViewCloseCommand}" CommandParameter="{Binding}">
                                                        <Path Data="{StaticResource CaptionClose}" Stroke="White" StrokeThickness="1" Width="10" Height="10"/>
                                                    </Button>
                                                </Grid>
                                                <Border Grid.Row="1" Background="#F2F2F2" Margin="6,0,6,6">
                                                    <Image Source="{Binding Icon}" Width="64" Height="64" Opacity="0.85"/>
                                                </Border>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Panel>
                </DockPanel>
            </Border>

            <!-- ===================== Recherche Windows ===================== -->
            <Border IsVisible="{Binding IsSearchOpen}" Background="{StaticResource StartMenuBrush}" Width="560" Height="520"
                    HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="48,0,0,0" BoxShadow="0 0 24 0 #80000000"
                    MaxHeight="{Binding #WorkArea.Bounds.Height}">
                <DockPanel>
                    <TextBox Name="SearchBox" DockPanel.Dock="Bottom" Text="{Binding SearchText}" Watermark="Taper ici pour rechercher"
                             FontSize="14" CornerRadius="0" Margin="0" Background="#F2F2F2" Foreground="#1F1F1F" MinHeight="40" Padding="12,10"/>
                    <StackPanel Margin="16,14">
                        <TextBlock Classes="white" Text="Meilleurs résultats" FontSize="13" Margin="0,0,0,8"/>
                        <ItemsControl ItemsSource="{Binding SearchResults}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Classes="flat startitem" Command="{Binding OpenCommand}">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <Image Source="{Binding Icon}" Width="28" Height="28" IsVisible="{Binding HasIcon}"/>
                                            <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                                <TextBlock Classes="white" Text="{Binding Title}" FontSize="14" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Subtitle}" Foreground="#BBBBBB" FontSize="11.5" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding Kind}" Foreground="#999999" FontSize="11.5" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Aucun résultat : applications, fichiers de Mes documents et paramètres sont recherchés."
                                   Foreground="#BBBBBB" FontSize="12.5" TextWrapping="Wrap" IsVisible="{Binding !HasSearchResults}"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ===================== Centre de notifications ===================== -->
            <Border IsVisible="{Binding IsActionCenterOpen}" Background="{StaticResource StartMenuBrush}" Width="380"
                    HorizontalAlignment="Right" BoxShadow="0 0 24 0 #80000000">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="12">
                        <TextBlock Classes="white" Text="{Binding VolumeLabel}" FontSize="12" Margin="2,0,0,2"/>
                        <Slider Minimum="0" Maximum="100" Value="{Binding Volume}"/>
                        <UniformGrid Columns="4" Margin="0,6,0,0">
                            <ToggleButton Classes="quick" IsChecked="{Binding DoNotDisturb}">
                                <StackPanel Spacing="6"><PathIcon Data="{StaticResource IconMoon}" Width="16" Height="16"/><TextBlock Text="Ne pas déranger" FontSize="11" TextWrapping="Wrap"/></StackPanel>
                            </ToggleButton>
                            <ToggleButton Classes="quick" IsChecked="{Binding NightLight}">
                                <StackPanel Spacing="6"><PathIcon Data="{StaticResource IconSettings}" Width="16" Height="16"/><TextBlock Text="Éclairage nocturne" FontSize="11" TextWrapping="Wrap"/></StackPanel>
                            </ToggleButton>
                            <ToggleButton Classes="quick" IsChecked="{Binding IsOnline, Mode=OneWay}" IsHitTestVisible="False">
                                <StackPanel Spacing="6"><PathIcon Data="{StaticResource IconNetwork}" Width="16" Height="16"/><TextBlock Text="Réseau ARGOS" FontSize="11" TextWrapping="Wrap"/></StackPanel>
                            </ToggleButton>
                            <Button Classes="flat quick" Command="{Binding OpenSettingsCommand}">
                                <StackPanel Spacing="6"><PathIcon Data="{StaticResource IconSettings}" Width="16" Height="16" Foreground="White"/><TextBlock Classes="white" Text="Tous les paramètres" FontSize="11" TextWrapping="Wrap"/></StackPanel>
                            </Button>
                        </UniformGrid>
                    </StackPanel>
                    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="16,14,12,8">
                        <TextBlock Classes="white" Text="Notifications" FontSize="15"/>
                        <Button Grid.Column="1" Classes="flat" Command="{Binding ClearNotificationsCommand}" Padding="6,2">
                            <TextBlock Text="Effacer toutes les notifications" Foreground="#76B9ED" FontSize="12"/>
                        </Button>
                    </Grid>
                    <Panel>
                        <TextBlock Text="Aucune nouvelle notification" Foreground="#BBBBBB" FontSize="13" HorizontalAlignment="Center"
                                   Margin="0,30,0,0" IsVisible="{Binding !HasNotifications}"/>
                        <ScrollViewer>
                            <ItemsControl ItemsSource="{Binding Notifications}" Margin="10,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#2B2B2B" Padding="12,10,6,10" Margin="0,0,0,6">
                                            <Grid ColumnDefinitions="Auto,*,Auto">
                                                <Image Source="{Binding Icon}" Width="20" Height="20" VerticalAlignment="Top" Margin="0,2,10,0" IsVisible="{Binding HasIcon}"/>
                                                <StackPanel Grid.Column="1" Spacing="2">
                                                    <TextBlock Classes="white" Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding Text}" Foreground="#CCCCCC" FontSize="12.5" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding Time}" Foreground="#999999" FontSize="11"/>
                                                </StackPanel>
                                                <Button Grid.Column="2" Classes="flat tray" Width="24" Height="24" VerticalAlignment="Top"
                                                        Command="{Binding DismissCommand}" ToolTip.Tip="Supprimer">
                                                    <Path Data="{StaticResource CaptionClose}" Stroke="White" StrokeThickness="1" Width="9" Height="9"/>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Panel>
                </DockPanel>
            </Border>

            <!-- ===================== Menu Démarrer ===================== -->
            <Border IsVisible="{Binding IsStartMenuOpen}"
                    Background="{StaticResource StartMenuBrush}"
                    HorizontalAlignment="Left" VerticalAlignment="Bottom"
                    Width="660" Height="580" MaxHeight="{Binding #WorkArea.Bounds.Height}"
                    BoxShadow="0 0 24 0 #80000000">
                <Grid ColumnDefinitions="48,250,*">

                    <!-- Rail gauche : profil, verrouiller, se déconnecter -->
                    <DockPanel>
                        <Button DockPanel.Dock="Top" Classes="flat rail" ToolTip.Tip="ARGOS">
                            <PathIcon Data="{StaticResource IconMenu}" Width="16" Height="16" Foreground="White"/>
                        </Button>
                        <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom">
                            <Button Classes="flat rail" ToolTip.Tip="{Binding DisplayName}">
                                <Border Width="26" Height="26" CornerRadius="13" ClipToBounds="True" Background="#59FFFFFF">
                                    <Panel>
                                        <PathIcon Data="{StaticResource IconPerson}" Width="16" Height="16" Foreground="White"
                                                  IsVisible="{Binding !HasAvatar}"/>
                                        <Image Source="{Binding Avatar}" Stretch="UniformToFill" IsVisible="{Binding HasAvatar}"/>
                                    </Panel>
                                </Border>
                                <Button.Flyout>
                                    <MenuFlyout Placement="RightEdgeAlignedBottom">
                                        <MenuItem Header="{Binding SessionInfo}" IsEnabled="False"/>
                                        <Separator/>
                                        <MenuItem Header="Modifier les paramètres du compte" Command="{Binding OpenSettingsCommand}" CommandParameter="comptes"/>
                                        <MenuItem Header="Verrouiller" Command="{Binding LockCommand}"/>
                                        <MenuItem Header="Se déconnecter" Command="{Binding SignOutCommand}"/>
                                        <MenuItem Header="Changer d'utilisateur" Command="{Binding SwitchUserCommand}"/>
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                            <Button Classes="flat rail" ToolTip.Tip="Paramètres" Command="{Binding OpenSettingsCommand}">
                                <PathIcon Data="{StaticResource IconSettings}" Width="16" Height="16" Foreground="White"/>
                            </Button>
                            <Button Classes="flat rail" ToolTip.Tip="Marche/Arrêt">
                                <PathIcon Data="{StaticResource IconPower}" Width="16" Height="16" Foreground="White"/>
                                <Button.Flyout>
                                    <MenuFlyout Placement="RightEdgeAlignedBottom">
                                        <MenuItem Header="Verrouiller" Command="{Binding LockCommand}"/>
                                        <MenuItem Header="Arrêter" Command="{Binding ShutdownCommand}" IsVisible="{Binding CanShutdown}"/>
                                        <MenuItem Header="Redémarrer" Command="{Binding RestartCommand}"/>
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>
                    </DockPanel>

                    <!-- Liste alphabétique des applications -->
                    <DockPanel Grid.Column="1">
                        <StackPanel DockPanel.Dock="Top" Margin="12,14,8,10" Spacing="2">
                            <TextBlock Classes="white" Text="{Binding DisplayName}" FontSize="15" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding LevelLabel}" Foreground="#BBBBBB" FontSize="12"/>
                            <TextBox Name="StartSearchBox" Text="{Binding StartSearch}" Watermark="Rechercher un logiciel"
                                     Margin="0,10,0,0" FontSize="13" CornerRadius="0" Background="#F2F2F2" Foreground="#1F1F1F"/>
                        </StackPanel>
                        <ScrollViewer IsVisible="{Binding IsStartSearching}">
                            <StackPanel>
                                <TextBlock Classes="white" Text="Meilleur résultat" FontSize="13" Margin="12,4,0,6"/>
                                <ItemsControl ItemsSource="{Binding StartResults}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Classes="flat startitem" Command="{Binding OpenCommand}">
                                                <StackPanel Orientation="Horizontal" Spacing="12">
                                                    <Image Source="{Binding Icon}" Width="28" Height="28"/>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Classes="white" Text="{Binding Title}" FontSize="14"/>
                                                        <TextBlock Text="{Binding Subtitle}" Foreground="#BBBBBB" FontSize="11.5"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="Aucun logiciel ne correspond." Foreground="#BBBBBB" FontSize="12" Margin="12,6"
                                           IsVisible="{Binding !StartResults.Count}"/>
                            </StackPanel>
                        </ScrollViewer>
                        <ScrollViewer IsVisible="{Binding !IsStartSearching}">
                            <ItemsControl ItemsSource="{Binding StartMenuEntries}">
                                <ItemsControl.DataTemplates>
                                    <DataTemplate DataType="vm:StartMenuHeader">
                                        <TextBlock Classes="white" Text="{Binding Letter}" FontSize="14"
                                                   Margin="12,10,0,4"/>
                                    </DataTemplate>
                                    <DataTemplate DataType="vm:AppTileViewModel">
                                        <Button Classes="flat startitem" Command="{Binding OpenCommand}">
                                            <StackPanel Orientation="Horizontal" Spacing="12">
                                                <Image Source="{Binding Icon}" Width="28" Height="28"
                                                       RenderOptions.BitmapInterpolationMode="HighQuality"/>
                                                <TextBlock Classes="white" Text="{Binding Title}" FontSize="14"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.DataTemplates>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>

                    <!-- Vignettes -->
                    <StackPanel Grid.Column="2" Margin="8,14,12,12">
                        <TextBlock Classes="white" Text="Applications BSPP" FontSize="13" Margin="2,0,0,10"/>
                        <ItemsControl ItemsSource="{Binding Apps}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Classes="flat tile" Command="{Binding OpenCommand}" ToolTip.Tip="{Binding Subtitle}">
                                        <Grid>
                                            <Image Source="{Binding Icon}" Width="46" Height="46"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Margin="0,0,0,12"
                                                   RenderOptions.BitmapInterpolationMode="HighQuality"/>
                                            <TextBlock Classes="white" Text="{Binding Title}" FontSize="11"
                                                       HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                                       Margin="6,0,6,4" TextTrimming="CharacterEllipsis"/>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
            </Border>
        </Panel>

        <!-- ===================== Barre des tâches ===================== -->
        <Border Grid.Row="1" Background="{StaticResource TaskbarBrush}">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto">

                <!-- Démarrer -->
                <Button Classes="flat taskbar" Classes.active="{Binding IsStartMenuOpen}"
                        Command="{Binding ToggleStartMenuCommand}" ToolTip.Tip="Démarrer">
                    <PathIcon Data="{StaticResource IconWindows}" Width="16" Height="16" Foreground="White"/>
                </Button>

                <!-- Recherche Windows et vue des tâches -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Classes="flat" Width="344" Height="40" Background="#F2F2F2"
                            HorizontalContentAlignment="Left" Padding="12,0" Cursor="IBeam"
                            Command="{Binding ToggleSearchCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <PathIcon Data="{StaticResource IconSearch}" Width="16" Height="16" Foreground="#1F1F1F"/>
                            <TextBlock Text="Taper ici pour rechercher" Foreground="#4F4F4F" FontSize="14"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="flat taskbar" Classes.active="{Binding IsTaskViewOpen}" Command="{Binding ToggleTaskViewCommand}"
                            ToolTip.Tip="Affichage des tâches">
                        <PathIcon Data="{StaticResource IconTaskView}" Width="18" Height="18" Foreground="White"/>
                    </Button>
                </StackPanel>

                <!-- Fenêtres ouvertes -->
                <ItemsControl Grid.Column="2" ItemsSource="{Binding Windows}" Margin="2,0,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Classes="flat taskbar" Classes.active="{Binding IsActive}"
                                    Command="{Binding TaskbarCommand}" ToolTip.Tip="{Binding Title}">
                                <Grid Width="48" Height="40">
                                    <Image Source="{Binding Icon}" Width="24" Height="24"
                                           RenderOptions.BitmapInterpolationMode="HighQuality"/>
                                    <Border Height="2" VerticalAlignment="Bottom" Margin="4,0"
                                            Background="{StaticResource AccentLightBrush}"/>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Zone de notification -->
                <StackPanel Grid.Column="3" Orientation="Horizontal">
                    <Button Classes="flat tray" ToolTip.Tip="Afficher les icônes cachées">
                        <PathIcon Data="{StaticResource IconChevronUp}" Width="14" Height="14" Foreground="White"/>
                    </Button>
                    <Button Classes="flat tray" ToolTip.Tip="{Binding NetworkTooltip}">
                        <PathIcon Data="{StaticResource IconNetwork}" Width="16" Height="16" Foreground="White"
                                  Classes.offline="{Binding !IsOnline}"/>
                        <Button.Flyout>
                            <Flyout Placement="TopEdgeAlignedRight">
                                <StackPanel Width="300" Spacing="6" Margin="4">
                                    <TextBlock Text="Réseau" FontWeight="SemiBold" FontSize="15"/>
                                    <TextBlock Text="{Binding NetworkTooltip}" FontSize="13"/>
                                    <TextBlock FontSize="12" Foreground="#5D5D5D"><Run Text="Serveur : "/><Run Text="{Binding ServerLabel}"/></TextBlock>
                                    <Button Content="Paramètres réseau" Command="{Binding OpenSettingsCommand}" CommandParameter="reseau" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <Button Classes="flat tray" ToolTip.Tip="{Binding VolumeLabel}">
                        <PathIcon Data="{StaticResource IconSpeaker}" Width="16" Height="16" Foreground="White" Classes.offline="{Binding Muted}"/>
                        <Button.Flyout>
                            <Flyout Placement="TopEdgeAlignedRight">
                                <StackPanel Width="300" Spacing="6" Margin="4">
                                    <TextBlock Text="{Binding VolumeLabel}" FontSize="13"/>
                                    <Slider Minimum="0" Maximum="100" Value="{Binding Volume}"/>
                                    <ToggleSwitch Content="Couper le son" IsChecked="{Binding Muted}"/>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <Button Classes="flat tray" Padding="8,0" ToolTip.Tip="{Binding LongDate}">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Classes="white" Text="{Binding TrayTime}" FontSize="12" HorizontalAlignment="Center"/>
                            <TextBlock Classes="white" Text="{Binding TrayDate}" FontSize="12" HorizontalAlignment="Center"/>
                        </StackPanel>
                        <Button.Flyout>
                            <Flyout Placement="TopEdgeAlignedRight">
                                <StackPanel Width="320" Margin="4" Spacing="4">
                                    <TextBlock Text="{Binding LongTime}" FontSize="40" FontWeight="Light"/>
                                    <TextBlock Text="{Binding LongDate}" FontSize="13" Foreground="#0078D7"/>
                                    <Calendar DisplayDate="{Binding CalendarDate}" SelectionMode="SingleDate" HorizontalAlignment="Stretch" Margin="0,8,0,0"/>
                                    <Button Content="Aujourd'hui" Command="{Binding TodayCommand}" HorizontalAlignment="Left"/>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <Button Classes="flat tray" ToolTip.Tip="Centre de notifications" Padding="10,0" Command="{Binding ToggleActionCenterCommand}">
                        <Panel>
                            <PathIcon Data="{StaticResource IconNotification}" Width="16" Height="16" Foreground="White"/>
                            <Border Background="#0078D7" CornerRadius="7" MinWidth="14" Height="14" Padding="3,0" Margin="10,-8,-8,0"
                                    HorizontalAlignment="Right" VerticalAlignment="Top" IsVisible="{Binding HasUnread}">
                                <TextBlock Text="{Binding UnreadNotifications}" Foreground="White" FontSize="9" HorizontalAlignment="Center"/>
                            </Border>
                        </Panel>
                    </Button>
                    <!-- « Afficher le bureau » : fine bande à l'extrême droite -->
                    <Button Classes="flat tray" Width="6" MinWidth="6" Padding="0" BorderThickness="1,0,0,0"
                            BorderBrush="#66FFFFFF" Command="{Binding ShowDesktopCommand}"
                            ToolTip.Tip="Afficher le Bureau"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
