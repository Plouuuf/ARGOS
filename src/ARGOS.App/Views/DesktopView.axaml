<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Argos.ViewModels"
             x:Class="Argos.Views.DesktopView">
    <UserControl.Styles>
        <Style Selector="TextBlock.iconlabel">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="MaxLines" Value="2"/>
            <Setter Property="Effect">
                <DropShadowEffect BlurRadius="4" OffsetX="1" OffsetY="1" Opacity="0.9" Color="Black"/>
            </Setter>
        </Style>
        <Style Selector="PathIcon.offline">
            <Setter Property="Opacity" Value="0.35"/>
        </Style>
        <Style Selector="TextBlock.white">
            <Setter Property="Foreground" Value="White"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="*,40">

        <!-- ===================== Zone de travail ===================== -->
        <Panel Name="WorkArea">
            <!-- Fond cliquable : ferme le menu Démarrer, désélectionne les icônes. -->
            <Border Name="Backdrop" Background="Transparent"/>

            <!-- Icônes du bureau, en colonnes depuis le coin supérieur gauche (comme Windows). -->
            <ItemsControl Name="DesktopIcons" ItemsSource="{Binding Apps}" Margin="2,4,0,0"
                          HorizontalAlignment="Left" VerticalAlignment="Top">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Vertical"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Classes="desktopicon"
                                Classes.selected="{Binding IsSelected}"
                                Width="78" Height="90" Margin="2"
                                ToolTip.Tip="{Binding Subtitle}">
                            <StackPanel Spacing="3" Margin="2,6,2,0">
                                <Image Source="{Binding Icon}" Width="48" Height="48"
                                       RenderOptions.BitmapInterpolationMode="HighQuality"/>
                                <TextBlock Classes="iconlabel" Text="{Binding Title}"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Fenêtres ouvertes (gérées par le code de la vue). -->
            <Canvas Name="WindowLayer"/>

            <!-- Notifications, coin inférieur droit. -->
            <ItemsControl ItemsSource="{Binding Toasts}"
                          HorizontalAlignment="Right" VerticalAlignment="Bottom"
                          Margin="0,0,12,12" Width="364">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="8"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource StartMenuBrush}" Padding="16,12,8,14"
                                BoxShadow="0 4 16 0 #66000000">
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Image Source="{Binding Icon}" Width="16" Height="16" IsVisible="{Binding HasIcon}"/>
                                    <TextBlock Classes="white" Text="ARGOS" FontSize="12" Opacity="0.8"/>
                                </StackPanel>
                                <Button Grid.Column="1" Classes="flat tray" Height="24" Width="24"
                                        Command="{Binding DismissCommand}" ToolTip.Tip="Fermer">
                                    <Path Data="{StaticResource CaptionClose}" Stroke="White" StrokeThickness="1"
                                          Width="10" Height="10"/>
                                </Button>
                                <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Classes="white" Text="{Binding Title}"
                                           FontSize="15" FontWeight="SemiBold" Margin="0,8,0,2" TextWrapping="Wrap"/>
                                <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding Text}"
                                           Foreground="#CCCCCC" FontSize="14" TextWrapping="Wrap"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ===================== Menu Démarrer ===================== -->
            <Border IsVisible="{Binding IsStartMenuOpen}"
                    Background="{StaticResource StartMenuBrush}"
                    HorizontalAlignment="Left" VerticalAlignment="Bottom"
                    Width="660" Height="580" MaxHeight="{Binding #WorkArea.Bounds.Height}"
                    BoxShadow="0 0 24 0 #80000000">
                <Grid ColumnDefinitions="48,250,*">

                    <!-- Rail gauche : profil, verrouiller, se déconnecter -->
                    <DockPanel>
                        <Button DockPanel.Dock="Top" Classes="flat rail" ToolTip.Tip="ARGOS">
                            <PathIcon Data="{StaticResource IconMenu}" Width="16" Height="16" Foreground="White"/>
                        </Button>
                        <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom">
                            <Button Classes="flat rail" ToolTip.Tip="{Binding DisplayName}">
                                <Border Width="26" Height="26" CornerRadius="13" ClipToBounds="True" Background="#59FFFFFF">
                                    <Panel>
                                        <PathIcon Data="{StaticResource IconPerson}" Width="16" Height="16" Foreground="White"
                                                  IsVisible="{Binding !HasAvatar}"/>
                                        <Image Source="{Binding Avatar}" Stretch="UniformToFill" IsVisible="{Binding HasAvatar}"/>
                                    </Panel>
                                </Border>
                            </Button>
                            <Button Classes="flat rail" ToolTip.Tip="Verrouiller" Command="{Binding LockCommand}">
                                <PathIcon Data="{StaticResource IconLock}" Width="16" Height="16" Foreground="White"/>
                            </Button>
                            <Button Classes="flat rail" ToolTip.Tip="Se déconnecter" Command="{Binding SignOutCommand}">
                                <PathIcon Data="{StaticResource IconPower}" Width="16" Height="16" Foreground="White"/>
                            </Button>
                        </StackPanel>
                    </DockPanel>

                    <!-- Liste alphabétique des applications -->
                    <DockPanel Grid.Column="1">
                        <StackPanel DockPanel.Dock="Top" Margin="12,14,8,10" Spacing="2">
                            <TextBlock Classes="white" Text="{Binding DisplayName}" FontSize="15" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding LevelLabel}" Foreground="#BBBBBB" FontSize="12"/>
                        </StackPanel>
                        <ScrollViewer>
                            <ItemsControl ItemsSource="{Binding StartMenuEntries}">
                                <ItemsControl.DataTemplates>
                                    <DataTemplate DataType="vm:StartMenuHeader">
                                        <TextBlock Classes="white" Text="{Binding Letter}" FontSize="14"
                                                   Margin="12,10,0,4"/>
                                    </DataTemplate>
                                    <DataTemplate DataType="vm:AppTileViewModel">
                                        <Button Classes="flat startitem" Command="{Binding OpenCommand}">
                                            <StackPanel Orientation="Horizontal" Spacing="12">
                                                <Image Source="{Binding Icon}" Width="28" Height="28"
                                                       RenderOptions.BitmapInterpolationMode="HighQuality"/>
                                                <TextBlock Classes="white" Text="{Binding Title}" FontSize="14"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.DataTemplates>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>

                    <!-- Vignettes -->
                    <StackPanel Grid.Column="2" Margin="8,14,12,12">
                        <TextBlock Classes="white" Text="Applications BSPP" FontSize="13" Margin="2,0,0,10"/>
                        <ItemsControl ItemsSource="{Binding Apps}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Classes="flat tile" Command="{Binding OpenCommand}" ToolTip.Tip="{Binding Subtitle}">
                                        <Grid>
                                            <Image Source="{Binding Icon}" Width="46" Height="46"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Margin="0,0,0,12"
                                                   RenderOptions.BitmapInterpolationMode="HighQuality"/>
                                            <TextBlock Classes="white" Text="{Binding Title}" FontSize="11"
                                                       HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                                       Margin="6,0,6,4" TextTrimming="CharacterEllipsis"/>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
            </Border>
        </Panel>

        <!-- ===================== Barre des tâches ===================== -->
        <Border Grid.Row="1" Background="{StaticResource TaskbarBrush}">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto">

                <!-- Démarrer -->
                <Button Classes="flat taskbar" Classes.active="{Binding IsStartMenuOpen}"
                        Command="{Binding ToggleStartMenuCommand}" ToolTip.Tip="Démarrer">
                    <PathIcon Data="{StaticResource IconWindows}" Width="16" Height="16" Foreground="White"/>
                </Button>

                <!-- Zone de recherche (ouvre le menu Démarrer) -->
                <Button Grid.Column="1" Classes="flat" Width="344" Height="40" Background="#F2F2F2"
                        HorizontalContentAlignment="Left" Padding="12,0" Cursor="IBeam"
                        Command="{Binding ToggleStartMenuCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <PathIcon Data="{StaticResource IconSearch}" Width="16" Height="16" Foreground="#1F1F1F"/>
                        <TextBlock Text="Taper ici pour rechercher" Foreground="#4F4F4F" FontSize="14"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Fenêtres ouvertes -->
                <ItemsControl Grid.Column="2" ItemsSource="{Binding Windows}" Margin="2,0,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Classes="flat taskbar" Classes.active="{Binding IsActive}"
                                    Command="{Binding TaskbarCommand}" ToolTip.Tip="{Binding Title}">
                                <Grid Width="48" Height="40">
                                    <Image Source="{Binding Icon}" Width="24" Height="24"
                                           RenderOptions.BitmapInterpolationMode="HighQuality"/>
                                    <Border Height="2" VerticalAlignment="Bottom" Margin="4,0"
                                            Background="{StaticResource AccentLightBrush}"/>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Zone de notification -->
                <StackPanel Grid.Column="3" Orientation="Horizontal">
                    <Button Classes="flat tray" ToolTip.Tip="Afficher les icônes cachées">
                        <PathIcon Data="{StaticResource IconChevronUp}" Width="14" Height="14" Foreground="White"/>
                    </Button>
                    <Button Classes="flat tray" ToolTip.Tip="{Binding NetworkTooltip}">
                        <PathIcon Data="{StaticResource IconNetwork}" Width="16" Height="16" Foreground="White"
                                  Classes.offline="{Binding !IsOnline}"/>
                    </Button>
                    <Button Classes="flat tray" ToolTip.Tip="Haut-parleurs">
                        <PathIcon Data="{StaticResource IconSpeaker}" Width="16" Height="16" Foreground="White"/>
                    </Button>
                    <Button Classes="flat tray" Padding="8,0">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Classes="white" Text="{Binding TrayTime}" FontSize="12" HorizontalAlignment="Center"/>
                            <TextBlock Classes="white" Text="{Binding TrayDate}" FontSize="12" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="flat tray" ToolTip.Tip="Centre de notifications" Padding="10,0">
                        <PathIcon Data="{StaticResource IconNotification}" Width="16" Height="16" Foreground="White"/>
                    </Button>
                    <!-- « Afficher le bureau » : fine bande à l'extrême droite -->
                    <Button Classes="flat tray" Width="6" MinWidth="6" Padding="0" BorderThickness="1,0,0,0"
                            BorderBrush="#66FFFFFF" Command="{Binding ShowDesktopCommand}"
                            ToolTip.Tip="Afficher le Bureau"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
