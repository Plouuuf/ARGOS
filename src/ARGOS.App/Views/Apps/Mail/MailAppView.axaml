<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m="using:Argos.Views.Apps.Mail"
             x:Class="Argos.Views.Apps.Mail.MailAppView"
             Classes="mail" Background="White"
             FontFamily="Segoe UI, Helvetica Neue, Arial, Liberation Sans" Foreground="#201F1E">
    <UserControl.Resources>
        <DataTemplate x:Key="MailContactTemplate">
            <Border BorderBrush="#EDEBE9" BorderThickness="0,0,0,1" Padding="0,7">
                <Grid ColumnDefinitions="Auto,12,*,Auto">
                    <Border Classes="avatar" Width="34" Height="34" CornerRadius="17" Background="#8A8886">
                        <TextBlock Text="{Binding Name, Converter={x:Static m:MailConverters.Initials}}" Foreground="White" FontSize="12" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Address}" FontSize="12" Foreground="#0078D4"/>
                        <TextBlock Classes="muted" Text="{Binding Details}" IsVisible="{Binding Details, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <Button Classes="cmd" Content="Écrire" Command="{Binding WriteCommand}" Foreground="#0078D4"/>
                        <Button Classes="cmd" Content="{Binding Personal, Converter={x:Static m:MailConverters.EditLabel}}" Command="{Binding EditCommand}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>
    <DockPanel>
        <!-- Barre supérieure -->
        <Border DockPanel.Dock="Top" Background="#0078D4" Height="46" Padding="14,0">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Image Source="avares://ARGOS.App/Assets/Icons/mail.png" Width="26" Height="26"/>
                    <TextBlock Text="Messagerie" Foreground="White" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBox Grid.Column="1" Text="{Binding Search}" Watermark="Rechercher dans le courrier et les contacts" MaxWidth="460" Margin="40,0"
                         Background="#C7E0F4" BorderThickness="0" CornerRadius="2" FontSize="13" VerticalAlignment="Center" MinHeight="30"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <StackPanel HorizontalAlignment="Right">
                        <TextBlock Text="{Binding Name}" Foreground="White" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                        <TextBlock Text="{Binding Address}" Foreground="#DEECF9" FontSize="11" HorizontalAlignment="Right"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
        <!-- Commandes -->
        <Border DockPanel.Dock="Top" Background="#FAF9F8" BorderBrush="#EDEBE9" BorderThickness="0,0,0,1" Padding="8,4">
            <StackPanel Orientation="Horizontal" Spacing="2">
                <Button Classes="primary" Content="+ Nouveau message" Command="{Binding NewCommand}" Margin="4,0,12,0"/>
                <Button Classes="cmd" Content="Répondre" Command="{Binding ReplyCommand}"/>
                <Button Classes="cmd" Content="Répondre à tous" Command="{Binding ReplyAllCommand}"/>
                <Button Classes="cmd" Content="Transférer" Command="{Binding ForwardCommand}"/>
                <Button Classes="cmd" Content="Modifier le brouillon" Command="{Binding EditDraftCommand}" IsVisible="{Binding IsDraftSelected}"/>
                <Button Classes="cmd" Content="Supprimer" Command="{Binding DeleteCommand}"/>
                <Button Classes="cmd" Content="Restaurer" Command="{Binding RestoreCommand}" IsVisible="{Binding IsTrashSelected}"/>
                <Button Classes="cmd" Content="{Binding ReadLabel}" Command="{Binding ToggleReadCommand}"/>
                <Button Classes="cmd" Content="{Binding FlagLabel}" Command="{Binding ToggleFlagCommand}"/>
                <Button Classes="cmd" Content="Vider les éléments supprimés" Command="{Binding EmptyTrashCommand}" IsVisible="{Binding IsTrash}"/>
                <Button Classes="cmd" Content="Actualiser" Command="{Binding RefreshCommand}"/>
            </StackPanel>
        </Border>
        <Border DockPanel.Dock="Top" Padding="16,7" IsVisible="{Binding HasMessage}" Classes.err="{Binding MessageIsError}">
            <Border.Styles><Style Selector="Border"><Setter Property="Background" Value="#DFF6DD"/></Style>
                    <Style Selector="Border.err"><Setter Property="Background" Value="#FDE7E9"/></Style></Border.Styles>
            <TextBlock Text="{Binding Message}" FontSize="12.5" TextWrapping="Wrap"/>
        </Border>

        <Grid ColumnDefinitions="210,*">
            <!-- Dossiers -->
            <Border Background="#F3F2F1" BorderBrush="#EDEBE9" BorderThickness="0,0,1,0">
                <StackPanel Margin="0,10">
                    <TextBlock Text="Dossiers" FontWeight="SemiBold" FontSize="13" Margin="18,0,0,6"/>
                    <ItemsControl ItemsSource="{Binding Folders}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Classes="folder" Classes.selected="{Binding Selected}" Command="{Binding SelectCommand}">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="{Binding Label}" FontSize="13" FontWeight="{Binding HasUnread, Converter={x:Static m:MailConverters.Bold}}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Unread}" FontSize="12.5" FontWeight="SemiBold" Foreground="#0078D4" IsVisible="{Binding HasUnread}"/>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border Height="1" Background="#E1DFDD" Margin="14,10"/>
                    <Button Classes="folder" Classes.selected="{Binding ShowContacts}" Command="{Binding ContactsCommand}">
                        <TextBlock Text="Contacts et annuaire" FontSize="13"/>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Courrier -->
            <Grid Grid.Column="1" ColumnDefinitions="360,*" IsVisible="{Binding ShowMailbox}">
                <Border BorderBrush="#EDEBE9" BorderThickness="0,0,1,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="{Binding FolderTitle}" FontSize="17" FontWeight="SemiBold" Margin="14,12,14,8"/>
                        <Panel>
                            <TextBlock Classes="muted" Text="Aucun élément à afficher." HorizontalAlignment="Center" Margin="0,30,0,0" IsVisible="{Binding !HasMessages}"/>
                            <ScrollViewer>
                                <ItemsControl ItemsSource="{Binding Messages}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Classes="row" Classes.selected="{Binding Selected}" Command="{Binding SelectCommand}">
                                                <Grid ColumnDefinitions="4,*">
                                                    <Border Background="#0078D4" IsVisible="{Binding Unread}"/>
                                                    <StackPanel Grid.Column="1" Margin="10,8,12,8" Spacing="1">
                                                        <Grid ColumnDefinitions="*,Auto">
                                                            <TextBlock Text="{Binding Correspondent}" FontSize="13.5" TextTrimming="CharacterEllipsis"
                                                                       FontWeight="{Binding Unread, Converter={x:Static m:MailConverters.Bold}}"/>
                                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                                                <TextBlock Text="!" Foreground="#A4262C" FontWeight="Bold" FontSize="13" IsVisible="{Binding High}"/>
                                                                <TextBlock Text="📎" FontSize="11" IsVisible="{Binding HasAttachments}"/>
                                                                <TextBlock Text="⚑" Foreground="#A4262C" FontSize="12" IsVisible="{Binding Flagged}"/>
                                                            </StackPanel>
                                                        </Grid>
                                                        <Grid ColumnDefinitions="*,Auto">
                                                            <TextBlock Text="{Binding Subject}" FontSize="12.5" TextTrimming="CharacterEllipsis"
                                                                       Foreground="{Binding Unread, Converter={x:Static m:MailConverters.Accent}}"
                                                                       FontWeight="{Binding Unread, Converter={x:Static m:MailConverters.Bold}}"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding Date}" FontSize="11.5" Foreground="#605E5C" Margin="8,0,0,0"/>
                                                        </Grid>
                                                        <TextBlock Text="[Brouillon]" FontSize="11.5" Foreground="#A4262C" IsVisible="{Binding IsDraft}"/>
                                                        <TextBlock Text="{Binding Preview}" FontSize="12" Foreground="#605E5C" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Panel>
                    </DockPanel>
                </Border>

                <!-- Volet de lecture -->
                <Panel Grid.Column="1">
                    <StackPanel IsVisible="{Binding NoSelection}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
                        <Image Source="avares://ARGOS.App/Assets/Icons/mail.png" Width="64" Height="64" Opacity="0.35"/>
                        <TextBlock Text="Sélectionnez un élément à lire" FontSize="15" Foreground="#605E5C" HorizontalAlignment="Center"/>
                        <TextBlock Text="Rien n'est sélectionné" Classes="muted" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <ScrollViewer IsVisible="{Binding HasSelection}">
                        <StackPanel Margin="24,16">
                            <TextBlock Text="{Binding ReadSubject}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock Text="! Importance haute" Foreground="#A4262C" FontWeight="SemiBold" FontSize="12" Margin="0,4,0,0" IsVisible="{Binding ReadHigh}"/>
                            <Grid ColumnDefinitions="Auto,12,*" Margin="0,14,0,0">
                                <Border Classes="avatar">
                                    <TextBlock Text="{Binding ReadInitials}" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="2" Spacing="1">
                                    <TextBlock Text="{Binding ReadFrom}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock Classes="muted" Text="{Binding ReadDate}"/>
                                    <TextBlock Classes="muted" TextWrapping="Wrap"><Run Text="À : "/><Run Text="{Binding ReadTo}"/></TextBlock>
                                    <TextBlock Classes="muted" TextWrapping="Wrap" IsVisible="{Binding HasCc}"><Run Text="Cc : "/><Run Text="{Binding ReadCc}"/></TextBlock>
                                    <TextBlock Classes="muted" TextWrapping="Wrap" IsVisible="{Binding HasBcc}"><Run Text="Cci : "/><Run Text="{Binding ReadBcc}"/></TextBlock>
                                </StackPanel>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding Attachments}" Margin="0,14,0,0" IsVisible="{Binding HasAttachments}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#E1DFDD" BorderThickness="1" CornerRadius="2" Padding="10,6" Margin="0,0,8,8">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" MaxWidth="220" TextTrimming="CharacterEllipsis"/>
                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                    <TextBlock Classes="muted" Text="{Binding Size}"/>
                                                    <Button Classes="cmd" Padding="4,0" FontSize="12" Foreground="#0078D4" Content="Ouvrir" Command="{Binding OpenCommand}"/>
                                                    <Button Classes="cmd" Padding="4,0" FontSize="12" Foreground="#0078D4" Content="Enregistrer" Command="{Binding SaveCommand}"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Border Height="1" Background="#EDEBE9" Margin="0,12"/>
                            <SelectableTextBlock m:MailText.Body="{Binding ReadBody}" FontSize="14" TextWrapping="Wrap" LineHeight="21"/>
                        </StackPanel>
                    </ScrollViewer>
                </Panel>
            </Grid>

            <!-- Contacts -->
            <Grid Grid.Column="1" ColumnDefinitions="*,320" IsVisible="{Binding ShowContacts}">
                <ScrollViewer>
                    <StackPanel Margin="20,14">
                        <TextBlock Text="Mes contacts" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <ItemsControl ItemsSource="{Binding Contacts}">
                            <ItemsControl.ItemTemplate><DataTemplate><ContentControl Content="{Binding}" ContentTemplate="{StaticResource MailContactTemplate}"/></DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Classes="muted" Text="Aucun contact personnel. Ajoutez-en à droite, ou depuis l'annuaire." IsVisible="{Binding !Contacts.Count}"/>
                        <TextBlock Text="Annuaire de la compagnie" FontSize="17" FontWeight="SemiBold" Margin="0,20,0,8"/>
                        <ItemsControl ItemsSource="{Binding Directory}">
                            <ItemsControl.ItemTemplate><DataTemplate><ContentControl Content="{Binding}" ContentTemplate="{StaticResource MailContactTemplate}"/></DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
                <Border Grid.Column="1" Background="#FAF9F8" BorderBrush="#EDEBE9" BorderThickness="1,0,0,0">
                    <StackPanel Margin="16,14" Spacing="4">
                        <TextBlock Text="Contact" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Classes="lbl" Text="Nom" Margin="0,6,0,0"/>
                        <TextBox Classes="box" Text="{Binding EditedContact.Name}"/>
                        <TextBlock Classes="lbl" Text="Adresse électronique" Margin="0,6,0,0"/>
                        <TextBox Classes="box" Text="{Binding EditedContact.Address}" Watermark="prenom.nom@pompiersparis.fr"/>
                        <TextBlock Classes="lbl" Text="Notes" Margin="0,6,0,0"/>
                        <TextBox Classes="box" Text="{Binding EditedContact.Notes}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="54"/>
                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,8,0,0">
                            <Button Classes="primary" Content="Enregistrer" Command="{Binding SaveContactCommand}"/>
                            <Button Classes="cmd" Content="Nouveau" Command="{Binding NewContactCommand}"/>
                            <Button Classes="cmd" Content="Supprimer" Command="{Binding DeleteContactCommand}"/>
                        </StackPanel>
                        <Border Height="1" Background="#E1DFDD" Margin="0,16,0,8"/>
                        <TextBlock Text="Signature" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Classes="muted" Text="Ajoutée aux nouveaux messages, réponses et transferts." TextWrapping="Wrap"/>
                        <TextBox Classes="box" Text="{Binding Signature}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90"
                                 Watermark="Sgt SANTOS Diego&#10;Chef d'agrès VSAV - CS Créteil"/>
                        <Button Classes="primary" Content="Enregistrer la signature" Command="{Binding SaveSignatureCommand}" HorizontalAlignment="Left" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>

</UserControl>
