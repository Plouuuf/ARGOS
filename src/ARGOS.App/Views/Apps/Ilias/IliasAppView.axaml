<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Argos.Views.Apps.Ilias.IliasAppView"
             Classes="ilias"
             Background="#F0F2F5"
             FontFamily="Segoe UI, Helvetica Neue, Arial, Liberation Sans"
             Foreground="#161616">
    <!-- ILIAS : plateforme pédagogique (charte « Delos » : barre principale ardoise, tuiles blanches). -->

    <Grid ColumnDefinitions="200,*">
        <!-- Barre principale -->
        <Border Background="#2D4053">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="16,16,16,18" Spacing="4">
                    <Image Source="avares://ARGOS.App/Assets/Icons/ilias.png" Width="48" Height="48" HorizontalAlignment="Left"/>
                    <TextBlock Text="ILIAS" Foreground="White" FontSize="18" FontWeight="Bold"/>
                    <TextBlock Text="Formation et documentation BSPP" Foreground="#AFC0D0" FontSize="11" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="16,0,16,14" Spacing="2">
                    <TextBlock Text="{Binding UserName}" Foreground="White" FontSize="11.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding UserAccess}" Foreground="#AFC0D0" FontSize="11"/>
                </StackPanel>
                <StackPanel>
                    <Button Classes="nav" Classes.selected="{Binding IsAccueil}" Content="Accueil" Command="{Binding NavigateCommand}" CommandParameter="Accueil"/>
                    <Button Classes="nav" Classes.selected="{Binding IsBibliotheque}" Content="Bibliothèque" Command="{Binding NavigateCommand}" CommandParameter="Bibliotheque"/>
                    <Button Classes="nav" Classes.selected="{Binding IsFormations}" Content="Formations" Command="{Binding NavigateCommand}" CommandParameter="Formations"/>
                    <Button Classes="nav" Classes.selected="{Binding IsQuestionnaires}" Content="Questionnaires" Command="{Binding NavigateCommand}" CommandParameter="Questionnaires"/>
                    <Button Classes="nav" Classes.selected="{Binding IsSuivi}" Content="Suivi pédagogique" Command="{Binding NavigateCommand}" CommandParameter="Suivi"/>
                    <Button Classes="nav" Classes.selected="{Binding IsAdministration}" Content="Administration" Command="{Binding NavigateCommand}" CommandParameter="Administration"
                            IsVisible="{Binding CanAdmin}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <DockPanel Grid.Column="1">
            <Border DockPanel.Dock="Top" Background="White" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" Padding="20,10">
                <Grid ColumnDefinitions="*,10,Auto">
                    <TextBox Classes="il" Text="{Binding Search}" Watermark="Rechercher un document (titre, mot-clé)…" MaxWidth="520" HorizontalAlignment="Left"/>
                    <Button Grid.Column="2" Classes="il light" Content="Actualiser" Command="{Binding RefreshCommand}"/>
                </Grid>
            </Border>
            <Border DockPanel.Dock="Top" Padding="20,8" IsVisible="{Binding HasMessage}" Background="#E3F1E3" Classes.err="{Binding MessageIsError}">
                <Border.Styles>
                    <Style Selector="Border.err"><Setter Property="Background" Value="#F8E1E1"/></Style>
                </Border.Styles>
                <TextBlock Text="{Binding Message}" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap"/>
            </Border>

            <Panel>
                <!-- ===== Accueil ===== -->
                <ScrollViewer IsVisible="{Binding IsAccueil}">
                    <StackPanel Margin="20,16">
                        <TextBlock Classes="h1" Text="Tableau de bord"/>
                        <TextBlock Classes="h2" Text="Catégories documentaires"/>
                        <ItemsControl ItemsSource="{Binding MainCategories}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Classes="card" Width="250">
                                        <StackPanel Spacing="4">
                                            <Button Classes="link" Content="{Binding Name}" Command="{Binding SelectCommand}"/>
                                            <TextBlock Classes="muted" Text="{Binding Description}" MaxHeight="34"/>
                                            <TextBlock Classes="muted" Text="{Binding Count, StringFormat='{}{0} document(s)'}" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Grid ColumnDefinitions="*,*">
                            <StackPanel>
                                <TextBlock Classes="h2" Text="Dernières publications"/>
                                <ItemsControl ItemsSource="{Binding Latest}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,12,8">
                                                <Button Classes="link" Content="{Binding Title}" Command="{Binding OpenCommand}"/>
                                                <TextBlock Classes="muted"><Run Text="{Binding Category}"/><Run Text=" · mis à jour le "/><Run Text="{Binding Updated}"/></TextBlock>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Classes="muted" Text="Aucun document publié pour le moment." IsVisible="{Binding !Latest.Count}"/>
                                <TextBlock Classes="h2" Text="Consultés récemment"/>
                                <ItemsControl ItemsSource="{Binding Recent}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Classes="link" Content="{Binding Title}" Command="{Binding OpenCommand}" Margin="0,0,0,6"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Classes="muted" Text="Aucun document consulté." IsVisible="{Binding !Recent.Count}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Classes="h2" Text="Formations disponibles"/>
                                <ItemsControl ItemsSource="{Binding FormationsHome}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Classes="card" Margin="0,0,0,10">
                                                <StackPanel Spacing="4">
                                                    <Button Classes="link" Content="{Binding Title}" Command="{Binding OpenCommand}"/>
                                                    <ProgressBar Minimum="0" Maximum="1" Value="{Binding Progress}" Height="6" Foreground="#4C6586" Background="#E4E8EE"/>
                                                    <TextBlock Classes="muted"><Run Text="{Binding State}"/><Run Text=" · "/><Run Text="{Binding ProgressLabel}"/></TextBlock>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===== Bibliothèque ===== -->
                <Grid IsVisible="{Binding IsBibliotheque}" ColumnDefinitions="240,*">
                    <Border Background="White" BorderBrush="#DDDDDD" BorderThickness="0,0,1,0">
                        <ScrollViewer>
                            <StackPanel Margin="10,14">
                                <TextBlock Text="CATÉGORIES" FontSize="11" FontWeight="Bold" Foreground="#6F6F6F" Margin="6,0,0,8"/>
                                <Button Classes="link" Content="Tous les documents" Command="{Binding AllCategoriesCommand}" Margin="6,0,0,8"/>
                                <ItemsControl ItemsSource="{Binding Categories}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnDefinitions="*,Auto" Margin="{Binding Indent}">
                                                <Button Classes="link" FontWeight="Normal" FontSize="13" Content="{Binding Name}" Command="{Binding SelectCommand}" Margin="6,3"/>
                                                <TextBlock Grid.Column="1" Classes="muted" Text="{Binding Count}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                    <ScrollViewer Grid.Column="1">
                        <StackPanel Margin="20,16">
                            <TextBlock Classes="h1" Text="{Binding CategoryTitle}" Margin="0,0,0,2"/>
                            <TextBlock Classes="muted" Text="{Binding CategoryDescription}" Margin="0,0,0,12"/>
                            <ItemsControl ItemsSource="{Binding Documents}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Classes="card" Margin="0,0,0,10">
                                            <Grid ColumnDefinitions="40,12,*,Auto">
                                                <Border Width="40" Height="48" Background="#C62828" CornerRadius="2" VerticalAlignment="Top">
                                                    <TextBlock Text="PDF" Foreground="White" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Grid.Column="2" Spacing="3">
                                                    <Button Classes="link" Content="{Binding Title}" Command="{Binding OpenCommand}"/>
                                                    <TextBlock Classes="muted" Text="{Binding Description}"/>
                                                    <TextBlock Classes="muted" FontSize="11">
                                                        <Run Text="{Binding Category}"/><Run Text=" · publié le "/><Run Text="{Binding Published}"/>
                                                        <Run Text=" · mis à jour le "/><Run Text="{Binding Updated}"/><Run Text=" · version "/><Run Text="{Binding Version}"/>
                                                        <Run Text=" · "/><Run Text="{Binding Size}"/>
                                                    </TextBlock>
                                                    <TextBlock Text="Archivé" Foreground="#C62828" FontSize="11" FontWeight="Bold" IsVisible="{Binding Archived}"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="3" Spacing="6" VerticalAlignment="Center">
                                                    <Button Classes="il" Content="Ouvrir" Command="{Binding OpenCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                                                    <Button Classes="il light" Content="Télécharger" Command="{Binding DownloadCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                                                    <Button Classes="il light" Content="Modifier" Command="{Binding EditCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                                            IsVisible="{Binding $parent[UserControl].DataContext.CanAdmin}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Classes="muted" Text="Aucun document dans cette catégorie." IsVisible="{Binding !Documents.Count}"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- ===== Formations ===== -->
                <ScrollViewer IsVisible="{Binding IsFormations}">
                    <StackPanel Margin="20,16">
                        <TextBlock Classes="h1" Text="Formations"/>
                        <ItemsControl ItemsSource="{Binding Formations}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Classes="card" Width="330">
                                        <StackPanel Spacing="6">
                                            <Button Classes="link" Content="{Binding Title}" Command="{Binding OpenCommand}"/>
                                            <TextBlock Classes="muted" Text="{Binding Description}"/>
                                            <ProgressBar Minimum="0" Maximum="1" Value="{Binding Progress}" Height="6" Foreground="#4C6586" Background="#E4E8EE"/>
                                            <TextBlock Classes="muted"><Run Text="{Binding State}" FontWeight="SemiBold"/><Run Text=" · "/><Run Text="{Binding ProgressLabel}"/></TextBlock>
                                            <Button Classes="il" Content="Ouvrir la formation" Command="{Binding OpenCommand}" HorizontalAlignment="Left"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Classes="muted" Text="Aucune formation disponible." IsVisible="{Binding !Formations.Count}"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===== Questionnaires ===== -->
                <ScrollViewer IsVisible="{Binding IsQuestionnaires}">
                    <StackPanel Margin="20,16">
                        <TextBlock Classes="h1" Text="Questionnaires et évaluations"/>
                        <ItemsControl ItemsSource="{Binding Quizzes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Classes="card" Margin="0,0,0,10">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Spacing="3">
                                                <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"/>
                                                <TextBlock Classes="muted" Text="{Binding Description}"/>
                                                <TextBlock Classes="muted"><Run Text="{Binding Questions}"/><Run Text=" question(s) · "/><Run Text="{Binding Timer}"/><Run Text=" · "/><Run Text="{Binding LastResult}"/></TextBlock>
                                            </StackPanel>
                                            <Button Grid.Column="1" Classes="il" Content="Commencer" Command="{Binding StartCommand}" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Classes="h2" Text="Mes anciennes évaluations"/>
                        <ItemsControl ItemsSource="{Binding Results}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="130,*,140,90" Margin="0,0,0,4">
                                        <TextBlock Text="{Binding Date}" FontSize="12.5"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Quiz}" FontSize="12.5"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Score}" FontSize="12.5" FontWeight="SemiBold"/>
                                        <Panel Grid.Column="3">
                                            <TextBlock Text="Réussie" Foreground="#2E7D32" FontWeight="SemiBold" FontSize="12.5" IsVisible="{Binding Passed}"/>
                                            <TextBlock Text="Échouée" Foreground="#C62828" FontWeight="SemiBold" FontSize="12.5" IsVisible="{Binding !Passed}"/>
                                        </Panel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Classes="muted" Text="Aucune évaluation passée." IsVisible="{Binding !Results.Count}"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===== Suivi pédagogique ===== -->
                <ScrollViewer IsVisible="{Binding IsSuivi}">
                    <StackPanel Margin="20,16">
                        <TextBlock Classes="h1" Text="Suivi pédagogique"/>
                        <WrapPanel>
                            <Border Classes="card" Width="190"><StackPanel><TextBlock Text="{Binding FormationsFollowed}" FontSize="28" FontWeight="Light"/><TextBlock Classes="muted" Text="Formations suivies"/></StackPanel></Border>
                            <Border Classes="card" Width="190"><StackPanel><TextBlock Text="{Binding FormationsValidated}" FontSize="28" FontWeight="Light" Foreground="#2E7D32"/><TextBlock Classes="muted" Text="Formations validées"/></StackPanel></Border>
                            <Border Classes="card" Width="190"><StackPanel><TextBlock Text="{Binding QuizzesPassed}" FontSize="28" FontWeight="Light" Foreground="#2E7D32"/><TextBlock Classes="muted" Text="Évaluations réussies"/></StackPanel></Border>
                            <Border Classes="card" Width="190"><StackPanel><TextBlock Text="{Binding QuizzesFailed}" FontSize="28" FontWeight="Light" Foreground="#C62828"/><TextBlock Classes="muted" Text="Évaluations échouées"/></StackPanel></Border>
                        </WrapPanel>
                        <TextBlock Classes="h2" Text="Progression globale"/>
                        <Grid ColumnDefinitions="*,60" MaxWidth="600" HorizontalAlignment="Left">
                            <ProgressBar Minimum="0" Maximum="1" Value="{Binding GlobalProgress}" Height="12" Foreground="#4C6586" Background="#E4E8EE"/>
                            <TextBlock Grid.Column="1" Text="{Binding GlobalProgressLabel}" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock Classes="h2" Text="Formations validées"/>
                        <ItemsControl ItemsSource="{Binding ValidatedFormations}">
                            <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" FontSize="13" Margin="0,0,0,4"/></DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Classes="muted" Text="Aucune formation validée." IsVisible="{Binding !ValidatedFormations.Count}"/>
                        <TextBlock Classes="h2" Text="Notes"/>
                        <ItemsControl ItemsSource="{Binding Results}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock FontSize="12.5" Margin="0,0,0,3"><Run Text="{Binding Date}"/><Run Text=" · "/><Run Text="{Binding Quiz}"/><Run Text=" · "/><Run Text="{Binding Score}" FontWeight="SemiBold"/></TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===== Administration documentaire ===== -->
                <ScrollViewer IsVisible="{Binding IsAdministration}">
                    <StackPanel Margin="20,16" MaxWidth="980" HorizontalAlignment="Left">
                        <TextBlock Classes="h1" Text="Administration documentaire"/>

                        <!-- Catégories -->
                        <Border Classes="card" Margin="0,0,0,14">
                            <StackPanel>
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Classes="h2" Text="Catégories" Margin="0"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"><Button Classes="il light" Content="Nouveau" Command="{Binding NewCategoryCommand}"/><ComboBox Classes="il" Width="300" PlaceholderText="Modifier un élément existant…" ItemsSource="{Binding CategoryEditChoices}" SelectedItem="{Binding CategoryPick}"/></StackPanel>
                                </Grid>
                                <Grid ColumnDefinitions="*,12,*">
                                    <StackPanel>
                                        <TextBlock Classes="lbl" Text="Nom"/>
                                        <TextBox Classes="il" Text="{Binding EditedCategory.Name}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Classes="lbl" Text="Catégorie parente"/>
                                        <ComboBox Classes="il" ItemsSource="{Binding ParentChoices}" SelectedItem="{Binding CategoryParent}"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Classes="lbl" Text="Description"/>
                                <TextBox Classes="il" Text="{Binding EditedCategory.Description}"/>
                                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,10,0,0">
                                    <CheckBox Content="Archivée" IsChecked="{Binding EditedCategory.Archived}"/>
                                    <Button Classes="il" Content="Enregistrer la catégorie" Command="{Binding SaveCategoryCommand}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Documents -->
                        <Border Classes="card" Margin="0,0,0,14">
                            <StackPanel>
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Classes="h2" Text="Documents" Margin="0"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"><Button Classes="il light" Content="Nouveau" Command="{Binding NewDocumentCommand}"/><ComboBox Classes="il" Width="300" PlaceholderText="Modifier un élément existant…" ItemsSource="{Binding DocumentEditChoices}" SelectedItem="{Binding DocumentPick}"/></StackPanel>
                                </Grid>
                                <Grid ColumnDefinitions="*,12,*">
                                    <StackPanel>
                                        <TextBlock Classes="lbl" Text="Titre"/>
                                        <TextBox Classes="il" Text="{Binding EditedDocument.Title}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Classes="lbl" Text="Catégorie"/>
                                        <ComboBox Classes="il" ItemsSource="{Binding CategoryChoices}" SelectedItem="{Binding DocumentCategory}"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Classes="lbl" Text="Description"/>
                                <TextBox Classes="il" Text="{Binding EditedDocument.Description}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="44"/>
                                <Grid ColumnDefinitions="*,12,*">
                                    <StackPanel>
                                        <TextBlock Classes="lbl" Text="Mots-clés"/>
                                        <TextBox Classes="il" Text="{Binding EditedDocument.Keywords}" Watermark="SUAP, bilan, VSAV…"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Classes="lbl" Text="Droits d'accès"/>
                                        <ComboBox Classes="il" ItemsSource="{Binding Audiences}" SelectedItem="{Binding EditedDocument.Audience}"/>
                                    </StackPanel>
                                </Grid>
                                <Grid ColumnDefinitions="Auto,10,*" Margin="0,10,0,0">
                                    <Button Name="FileButton" Classes="il light" Content="Choisir le fichier PDF…"/>
                                    <TextBlock Grid.Column="2" Classes="muted" Text="{Binding PendingFileLabel}" VerticalAlignment="Center"/>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,10,0,0">
                                    <CheckBox Content="Téléchargement autorisé" IsChecked="{Binding EditedDocument.Downloadable}"/>
                                    <CheckBox Content="Archivé" IsChecked="{Binding EditedDocument.Archived}"/>
                                    <Button Classes="il" Content="Enregistrer le document" Command="{Binding SaveDocumentCommand}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Formations -->
                        <Border Classes="card" Margin="0,0,0,14">
                            <StackPanel>
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Classes="h2" Text="Formations" Margin="0"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"><Button Classes="il light" Content="Nouveau" Command="{Binding NewFormationCommand}"/><ComboBox Classes="il" Width="300" PlaceholderText="Modifier un élément existant…" ItemsSource="{Binding FormationEditChoices}" SelectedItem="{Binding FormationPick}"/></StackPanel>
                                </Grid>
                                <Grid ColumnDefinitions="*,12,*">
                                    <StackPanel>
                                        <TextBlock Classes="lbl" Text="Titre"/>
                                        <TextBox Classes="il" Text="{Binding EditedFormation.Title}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Classes="lbl" Text="Évaluation finale"/>
                                        <ComboBox Classes="il" ItemsSource="{Binding QuizChoices}" SelectedItem="{Binding FormationQuiz}"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Classes="lbl" Text="Description"/>
                                <TextBox Classes="il" Text="{Binding EditedFormation.Description}"/>
                                <Grid ColumnDefinitions="*,12,*">
                                    <StackPanel>
                                        <TextBlock Classes="lbl" Text="Objectifs"/>
                                        <TextBox Classes="il" Text="{Binding EditedFormation.Objectives}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="44"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Classes="lbl" Text="Prérequis"/>
                                        <TextBox Classes="il" Text="{Binding EditedFormation.Prerequisites}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="44"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Classes="lbl" Text="Droits d'accès"/>
                                <ComboBox Classes="il" Width="300" HorizontalAlignment="Left" ItemsSource="{Binding Audiences}" SelectedItem="{Binding EditedFormation.Audience}"/>
                                <TextBlock Classes="lbl" Text="Modules"/>
                                <ItemsControl ItemsSource="{Binding Modules}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#DDDDDD" BorderThickness="1" Padding="10" Margin="0,0,0,8">
                                                <StackPanel Spacing="6">
                                                    <Grid ColumnDefinitions="*,10,240,10,Auto">
                                                        <TextBox Classes="il" Text="{Binding Title}" Watermark="Titre du module"/>
                                                        <ComboBox Grid.Column="2" Classes="il" ItemsSource="{Binding Documents}" SelectedItem="{Binding Document}"/>
                                                        <Button Grid.Column="4" Classes="il light" Content="Retirer" Command="{Binding RemoveCommand}"/>
                                                    </Grid>
                                                    <TextBox Classes="il" Text="{Binding Content}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="54" Watermark="Contenu du module"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,6,0,0">
                                    <Button Classes="il light" Content="Ajouter un module" Command="{Binding AddModuleCommand}"/>
                                    <CheckBox Content="Archivée" IsChecked="{Binding EditedFormation.Archived}"/>
                                    <Button Classes="il" Content="Enregistrer la formation" Command="{Binding SaveFormationCommand}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Questionnaires -->
                        <Border Classes="card" Margin="0,0,0,14">
                            <StackPanel>
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Classes="h2" Text="Questionnaires" Margin="0"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"><Button Classes="il light" Content="Nouveau" Command="{Binding NewQuizCommand}"/><ComboBox Classes="il" Width="300" PlaceholderText="Modifier un élément existant…" ItemsSource="{Binding QuizEditChoices}" SelectedItem="{Binding QuizPick}"/></StackPanel>
                                </Grid>
                                <Grid ColumnDefinitions="*,12,110,12,110,12,190">
                                    <StackPanel>
                                        <TextBlock Classes="lbl" Text="Titre"/>
                                        <TextBox Classes="il" Text="{Binding EditedQuiz.Title}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Classes="lbl" Text="Durée (min)"/>
                                        <NumericUpDown Value="{Binding EditedQuiz.TimeLimitMinutes}" Minimum="0" Maximum="180" FormatString="0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Classes="lbl" Text="Réussite (%)"/>
                                        <NumericUpDown Value="{Binding EditedQuiz.PassPercent}" Minimum="0" Maximum="100" FormatString="0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="6">
                                        <TextBlock Classes="lbl" Text="Droits d'accès"/>
                                        <ComboBox Classes="il" ItemsSource="{Binding Audiences}" SelectedItem="{Binding EditedQuiz.Audience}"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Classes="lbl" Text="Description"/>
                                <TextBox Classes="il" Text="{Binding EditedQuiz.Description}"/>
                                <TextBlock Classes="lbl" Text="Questions (une réponse par ligne, n° de la bonne réponse)"/>
                                <ItemsControl ItemsSource="{Binding Questions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#DDDDDD" BorderThickness="1" Padding="10" Margin="0,0,0,8">
                                                <StackPanel Spacing="6">
                                                    <Grid ColumnDefinitions="*,10,Auto">
                                                        <TextBox Classes="il" Text="{Binding Text}" Watermark="Question"/>
                                                        <Button Grid.Column="2" Classes="il light" Content="Retirer" Command="{Binding RemoveCommand}"/>
                                                    </Grid>
                                                    <Grid ColumnDefinitions="*,10,110">
                                                        <TextBox Classes="il" Text="{Binding Options}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70"
                                                                 Watermark="Réponse 1&#10;Réponse 2&#10;Réponse 3"/>
                                                        <StackPanel Grid.Column="2">
                                                            <TextBlock Classes="lbl" Text="Bonne réponse n°" Margin="0,0,0,3"/>
                                                            <TextBox Classes="il" Text="{Binding Correct}"/>
                                                        </StackPanel>
                                                    </Grid>
                                                    <TextBox Classes="il" Text="{Binding Explanation}" Watermark="Correction / explication (facultatif)"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,6,0,0">
                                    <Button Classes="il light" Content="Ajouter une question" Command="{Binding AddQuestionCommand}"/>
                                    <CheckBox Content="Afficher les corrections" IsChecked="{Binding EditedQuiz.ShowCorrections}"/>
                                    <CheckBox Content="Archivé" IsChecked="{Binding EditedQuiz.Archived}"/>
                                    <Button Classes="il" Content="Enregistrer le questionnaire" Command="{Binding SaveQuizCommand}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Panel>
        </DockPanel>
    </Grid>
</UserControl>
