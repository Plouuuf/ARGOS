<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Argos.Views.Apps.Efibi.EfibiRecordView"
             Background="#D7E1E9"
             FontFamily="Segoe UI, Helvetica Neue, Arial, Liberation Sans"
             Foreground="#1F2D36">
    <!-- Fiche bilan en lecture seule, même présentation que CORTEX (bandeau bleu, rubriques en cartes, champs sur deux colonnes). -->
    <Grid Margin="8" RowDefinitions="Auto,Auto,*,42">
        <Border Background="#0D5B89" BorderBrush="#073B5B" BorderThickness="1" Padding="12" MinHeight="112">
            <Grid ColumnDefinitions="*,330">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="FICHE BILAN eFIBI" Foreground="White" FontWeight="Bold" FontSize="20"/>
                        <Border Background="#C43B31" Padding="6,2" VerticalAlignment="Center">
                            <TextBlock Text="LECTURE SEULE" Foreground="White" FontSize="10.5" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Foreground="#D8EAF5" Margin="0,6,0,0" TextWrapping="Wrap">
                        <Run Text="Intervention : "/><Run Text="{Binding Intervention, Mode=OneWay}" FontWeight="Bold"/><Run Text="   •   Auteur : "/><Run Text="{Binding Author, Mode=OneWay}" FontWeight="Bold"/>
                    </TextBlock>
                    <TextBlock Foreground="#D8EAF5" Margin="0,4,0,0" TextWrapping="Wrap">
                        <Run Text="Victime : "/><Run Text="{Binding Victim, Mode=OneWay}" FontWeight="SemiBold"/><Run Text="   •   Circonstances : "/><Run Text="{Binding Circumstances, Mode=OneWay}"/>
                    </TextBlock>
                    <TextBlock Foreground="#A9CBE0" Margin="0,4,0,0" FontSize="11.5" TextWrapping="Wrap">
                        <Run Text="Fiche n° "/><Run Text="{Binding Id, Mode=OneWay}"/><Run Text="   •   Identifiant FiveM du rédacteur : "/><Run Text="{Binding CitizenId, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding DisplayTimestamp}" Foreground="White" FontWeight="Bold" HorizontalAlignment="Right"/>
                    <Border Background="{Binding StatusBrush}" BorderBrush="White" BorderThickness="1" Padding="10,5" Margin="0,7,0,0"
                            HorizontalAlignment="Right" MinWidth="145">
                        <TextBlock Text="{Binding Status}" Foreground="White" FontWeight="Bold" TextAlignment="Center"/>
                    </Border>
                    <TextBlock Foreground="#D8EAF5" HorizontalAlignment="Right" Margin="0,6,0,0">
                        <Run Text="Code partage : "/><Run Text="{Binding ShareCode, Mode=OneWay}" FontWeight="SemiBold"/>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="#C43B31" IsVisible="{Binding HasError}" Padding="12,8" Margin="0,8,0,0">
            <TextBlock Text="{Binding Error}" Foreground="White" FontWeight="SemiBold" TextWrapping="Wrap"/>
        </Border>

        <Panel Grid.Row="2">
            <TextBlock Text="Chargement de la fiche…" Margin="8" Foreground="#5B6B7B" IsVisible="{Binding Loading}"/>
            <ScrollViewer IsVisible="{Binding HasRecord}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <WrapPanel Margin="0,8,0,0">
                    <!-- Informations de transmission -->
                    <Border Width="565" Background="White" BorderBrush="#93A9B8" BorderThickness="1" Margin="0,0,8,8" VerticalAlignment="Top">
                        <StackPanel>
                            <Border Background="#021BB0" BorderBrush="#02127A" BorderThickness="0,0,0,1" Padding="10,7">
                                <TextBlock Text="INFORMATIONS DE TRANSMISSION" Foreground="White" FontWeight="Bold" FontSize="12.5" HorizontalAlignment="Center"/>
                            </Border>
                            <UniformGrid Columns="2" Margin="7">
                                <Border Classes="field"><Grid RowDefinitions="24,*"><Border Classes="flabel"><TextBlock Classes="flabel" Text="Statut"/></Border>
                                    <SelectableTextBlock Grid.Row="1" Classes="fvalue" Text="{Binding Status}"/></Grid></Border>
                                <Border Classes="field"><Grid RowDefinitions="24,*"><Border Classes="flabel"><TextBlock Classes="flabel" Text="Date et heure de transmission"/></Border>
                                    <SelectableTextBlock Grid.Row="1" Classes="fvalue"><Run Text="{Binding TransmissionDate}"/><Run Text=" "/><Run Text="{Binding TransmissionTime}"/></SelectableTextBlock></Grid></Border>
                                <Border Classes="field"><Grid RowDefinitions="24,*"><Border Classes="flabel"><TextBlock Classes="flabel" Text="Prise en charge"/></Border>
                                    <SelectableTextBlock Grid.Row="1" Classes="fvalue" Text="{Binding Started}"/></Grid></Border>
                                <Border Classes="field"><Grid RowDefinitions="24,*"><Border Classes="flabel"><TextBlock Classes="flabel" Text="Fiche créée / mise à jour"/></Border>
                                    <SelectableTextBlock Grid.Row="1" Classes="fvalue"><Run Text="{Binding Created}"/><Run Text="&#10;"/><Run Text="{Binding Updated}"/></SelectableTextBlock></Grid></Border>
                                <Border Classes="field"><Grid RowDefinitions="24,*"><Border Classes="flabel"><TextBlock Classes="flabel" Text="Code de partage"/></Border>
                                    <SelectableTextBlock Grid.Row="1" Classes="fvalue" Text="{Binding ShareCode}"/></Grid></Border>
                                <Border Classes="field"><Grid RowDefinitions="24,*"><Border Classes="flabel"><TextBlock Classes="flabel" Text="Erreurs et historique"/></Border>
                                    <SelectableTextBlock Grid.Row="1" Classes="fvalue" Text="Non renseigné (absent de la base)" Foreground="#8A97A5"/></Grid></Border>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <!-- Rubriques du bilan -->
                    <ItemsControl ItemsSource="{Binding Sections}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="565" Background="White" BorderBrush="#93A9B8" BorderThickness="1" Margin="0,0,8,8" VerticalAlignment="Top">
                                    <StackPanel>
                                        <Border Background="#021BB0" BorderBrush="#02127A" BorderThickness="0,0,0,1" Padding="10,7">
                                            <TextBlock Text="{Binding Title}" Foreground="White" FontWeight="Bold" FontSize="12.5"
                                                       HorizontalAlignment="Center" TextAlignment="Center"/>
                                        </Border>
                                        <ItemsControl ItemsSource="{Binding Fields}" Margin="7,7,7,0">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Classes="field">
                                                        <Grid RowDefinitions="24,*">
                                                            <Border Classes="flabel"><TextBlock Classes="flabel" Text="{Binding Label}"/></Border>
                                                            <SelectableTextBlock Grid.Row="1" Classes="fvalue" Text="{Binding Value}"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <ItemsControl ItemsSource="{Binding Lists}" Margin="7,0,7,7">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Classes="field">
                                                        <Grid RowDefinitions="24,*">
                                                            <Border Classes="flabel"><TextBlock Classes="flabel" Text="{Binding Name}"/></Border>
                                                            <StackPanel Grid.Row="1" Margin="7,6">
                                                                <ItemsControl ItemsSource="{Binding Items}">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate><SelectableTextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12.5"/></DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                                <TextBlock Text="Non renseigné" Foreground="#8A97A5" FontSize="12.5" IsVisible="{Binding !Items.Count}"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </WrapPanel>
            </ScrollViewer>
        </Panel>

        <Border Grid.Row="3" Background="#E7EEF3" BorderBrush="#93A9B8" BorderThickness="1">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Consultation en lecture seule • données issues de la base eFIBI, aucune modification possible"
                           Foreground="#6B7D89" VerticalAlignment="Center" Margin="8,0" TextTrimming="CharacterEllipsis"/>
                <Button Grid.Column="1" Content="REVENIR AU REGISTRE" Height="27" Margin="8,0" Padding="12,0"
                        VerticalContentAlignment="Center" Command="{Binding CloseCommand}"/>
            </Grid>
        </Border>
    </Grid>

    <UserControl.Styles>
        <Style Selector="Border.field">
            <Setter Property="BorderBrush" Value="#D0D9E0"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="2"/><Setter Property="MinHeight" Value="58"/><Setter Property="Background" Value="#FAFBFC"/>
        </Style>
        <Style Selector="Border.flabel">
            <Setter Property="Background" Value="#E6E8EA"/><Setter Property="BorderBrush" Value="#D0D9E0"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="Padding" Value="6,3"/>
        </Style>
        <Style Selector="TextBlock.flabel">
            <Setter Property="Foreground" Value="#173D5A"/><Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="9.5"/><Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style Selector="SelectableTextBlock.fvalue">
            <Setter Property="Margin" Value="7,6"/><Setter Property="Foreground" Value="#1F2D36"/>
            <Setter Property="TextWrapping" Value="Wrap"/><Setter Property="FontSize" Value="12.5"/>
        </Style>
    </UserControl.Styles>
</UserControl>
