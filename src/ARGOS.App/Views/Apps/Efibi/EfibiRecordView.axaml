<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Argos.Views.Apps.Efibi.EfibiRecordView"
             Background="#F2F4F7"
             FontFamily="Segoe UI, Helvetica Neue, Arial, Liberation Sans"
             Foreground="#1C2733">
    <!-- Consultation d'une fiche bilan : en-tête d'identification, puis rubriques en deux colonnes libellé / valeur. Aucun arrondi. -->
    <UserControl.Resources>
        <CornerRadius x:Key="ControlCornerRadius">0</CornerRadius>
        <CornerRadius x:Key="OverlayCornerRadius">0</CornerRadius>
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- Bande d'identification -->
        <Style Selector="Border.idcell">
            <Setter Property="BorderBrush" Value="#D3DCE5"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
            <Setter Property="Padding" Value="14,10"/>
        </Style>
        <Style Selector="TextBlock.idlabel">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#6B7A89"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>
        <Style Selector="SelectableTextBlock.idvalue">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#1C2733"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style Selector="TextBlock.idsub">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#6B7A89"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <!-- Rubriques -->
        <Style Selector="Border.card">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#C9D3DD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
        <Style Selector="Border.cardhead">
            <Setter Property="Background" Value="#F3F6F9"/>
            <Setter Property="BorderBrush" Value="#0B5394"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="Padding" Value="14,8"/>
        </Style>
        <Style Selector="TextBlock.cardtitle">
            <Setter Property="Foreground" Value="#0B5394"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style Selector="Border.frow">
            <Setter Property="BorderBrush" Value="#E6EBF0"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>
        <Style Selector="Border.fcell">
            <Setter Property="Background" Value="#F7F9FB"/>
            <Setter Property="BorderBrush" Value="#E6EBF0"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
            <Setter Property="Padding" Value="14,7"/>
        </Style>
        <Style Selector="TextBlock.flabel">
            <Setter Property="Foreground" Value="#4A5968"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>
        <Style Selector="SelectableTextBlock.fvalue">
            <Setter Property="Margin" Value="14,7"/>
            <Setter Property="Foreground" Value="#1C2733"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>
        <Style Selector="SelectableTextBlock.fvalue.empty">
            <Setter Property="Foreground" Value="#A0ABB6"/>
            <Setter Property="FontStyle" Value="Italic"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <!-- Bouton -->
        <Style Selector="Button.ef">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#0B5394"/>
            <Setter Property="BorderBrush" Value="#B9C5D1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.ef:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#EAF1F8"/>
            <Setter Property="BorderBrush" Value="#0B5394"/>
            <Setter Property="Foreground" Value="#0B5394"/>
        </Style>
        <Style Selector="Button.ef:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#DCE7F2"/>
            <Setter Property="Foreground" Value="#0B5394"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
        <!-- Titre -->
        <Border Background="#0B5394" BorderBrush="#083F70" BorderThickness="0,0,0,1" Padding="18,10">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="FICHE BILAN" Foreground="#C9DCEE" FontSize="11" FontWeight="Bold"/>
                    <TextBlock Foreground="White" FontSize="20" FontWeight="Bold" TextWrapping="Wrap">
                        <Run Text="Intervention n° "/><Run Text="{Binding Intervention, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>
                <TextBlock Grid.Column="1" Foreground="#C9DCEE" FontSize="12" VerticalAlignment="Center">
                    <Run Text="Fiche n° "/><Run Text="{Binding Id, Mode=OneWay}" FontWeight="SemiBold"/>
                </TextBlock>
            </Grid>
        </Border>

        <!-- Bande d'identification : n° d'intervention, code fiche, horodatage, auteur, statut -->
        <Border Grid.Row="1" Background="White" BorderBrush="#C9D3DD" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,*,*,1.4*,Auto">
                <Border Classes="idcell">
                    <StackPanel>
                        <TextBlock Classes="idlabel" Text="N° D'INTERVENTION"/>
                        <SelectableTextBlock Classes="idvalue" Text="{Binding Intervention}" Foreground="#0B5394" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Classes="idcell">
                    <StackPanel>
                        <TextBlock Classes="idlabel" Text="CODE FICHE"/>
                        <SelectableTextBlock Classes="idvalue" Text="{Binding FicheCode}" FontFamily="Consolas, Menlo, DejaVu Sans Mono, monospace"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Classes="idcell">
                    <StackPanel>
                        <TextBlock Classes="idlabel" Text="HORODATAGE"/>
                        <SelectableTextBlock Classes="idvalue" Text="{Binding DisplayDate}"/>
                        <TextBlock Classes="idsub" Text="{Binding DisplayTime}" FontWeight="SemiBold" Foreground="#2F3E4C"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="3" Classes="idcell">
                    <StackPanel>
                        <TextBlock Classes="idlabel" Text="AUTEUR"/>
                        <SelectableTextBlock Classes="idvalue" Text="{Binding Author}"/>
                        <TextBlock Classes="idsub">
                            <Run Text="Identifiant FiveM : "/><Run Text="{Binding CitizenId, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                </Border>
                <Border Grid.Column="4" Classes="idcell" BorderThickness="0" MinWidth="170">
                    <StackPanel>
                        <TextBlock Classes="idlabel" Text="STATUT"/>
                        <Border Background="{Binding StatusBrush}" Padding="12,5" HorizontalAlignment="Stretch">
                            <TextBlock Text="{Binding Status}" Foreground="White" FontWeight="Bold" FontSize="12" TextAlignment="Center"
                                       HorizontalAlignment="Center" TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="#B3261E" IsVisible="{Binding HasError}" Padding="18,8">
            <TextBlock Text="{Binding Error}" Foreground="White" FontWeight="SemiBold" TextWrapping="Wrap"/>
        </Border>

        <Panel Grid.Row="3">
            <TextBlock Text="Chargement de la fiche…" Margin="18,14" Foreground="#6B7A89" IsVisible="{Binding Loading}"/>
            <ScrollViewer IsVisible="{Binding HasRecord}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="18,14,18,4">
                    <!-- Synthèse -->
                    <Border Classes="card">
                        <StackPanel>
                            <Border Classes="cardhead"><TextBlock Classes="cardtitle" Text="SYNTHÈSE"/></Border>
                            <Border Classes="frow">
                                <Grid ColumnDefinitions="240,*">
                                    <Border Classes="fcell"><TextBlock Classes="flabel" Text="Victime"/></Border>
                                    <SelectableTextBlock Grid.Column="1" Classes="fvalue" Text="{Binding Victim}" FontWeight="SemiBold"/>
                                </Grid>
                            </Border>
                            <Border Classes="frow" BorderThickness="0">
                                <Grid ColumnDefinitions="240,*">
                                    <Border Classes="fcell"><TextBlock Classes="flabel" Text="Bilan circonstanciel"/></Border>
                                    <SelectableTextBlock Grid.Column="1" Classes="fvalue" Text="{Binding Circumstances}"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Informations de transmission -->
                    <Border Classes="card">
                        <StackPanel>
                            <Border Classes="cardhead"><TextBlock Classes="cardtitle" Text="INFORMATIONS DE TRANSMISSION"/></Border>
                            <Border Classes="frow">
                                <Grid ColumnDefinitions="240,*">
                                    <Border Classes="fcell"><TextBlock Classes="flabel" Text="Statut"/></Border>
                                    <SelectableTextBlock Grid.Column="1" Classes="fvalue" Text="{Binding Status}" Foreground="{Binding StatusBrush}" FontWeight="SemiBold"/>
                                </Grid>
                            </Border>
                            <Border Classes="frow">
                                <Grid ColumnDefinitions="240,*">
                                    <Border Classes="fcell"><TextBlock Classes="flabel" Text="Date et heure de transmission"/></Border>
                                    <SelectableTextBlock Grid.Column="1" Classes="fvalue">
                                        <Run Text="{Binding TransmissionDate, Mode=OneWay}"/><Run Text=" "/><Run Text="{Binding TransmissionTime, Mode=OneWay}"/>
                                    </SelectableTextBlock>
                                </Grid>
                            </Border>
                            <Border Classes="frow">
                                <Grid ColumnDefinitions="240,*">
                                    <Border Classes="fcell"><TextBlock Classes="flabel" Text="Prise en charge"/></Border>
                                    <SelectableTextBlock Grid.Column="1" Classes="fvalue" Text="{Binding Started}"/>
                                </Grid>
                            </Border>
                            <Border Classes="frow">
                                <Grid ColumnDefinitions="240,*">
                                    <Border Classes="fcell"><TextBlock Classes="flabel" Text="Création de la fiche"/></Border>
                                    <SelectableTextBlock Grid.Column="1" Classes="fvalue" Text="{Binding Created}"/>
                                </Grid>
                            </Border>
                            <Border Classes="frow">
                                <Grid ColumnDefinitions="240,*">
                                    <Border Classes="fcell"><TextBlock Classes="flabel" Text="Dernière mise à jour"/></Border>
                                    <SelectableTextBlock Grid.Column="1" Classes="fvalue" Text="{Binding Updated}"/>
                                </Grid>
                            </Border>
                            <Border Classes="frow">
                                <Grid ColumnDefinitions="240,*">
                                    <Border Classes="fcell"><TextBlock Classes="flabel" Text="Code de partage"/></Border>
                                    <SelectableTextBlock Grid.Column="1" Classes="fvalue" Text="{Binding ShareCode}" FontFamily="Consolas, Menlo, DejaVu Sans Mono, monospace"/>
                                </Grid>
                            </Border>
                            <Border Classes="frow" BorderThickness="0">
                                <Grid ColumnDefinitions="240,*">
                                    <Border Classes="fcell"><TextBlock Classes="flabel" Text="Erreurs et historique"/></Border>
                                    <SelectableTextBlock Grid.Column="1" Classes="fvalue empty" Text="Non renseigné (absent de la base)"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Rubriques du bilan -->
                    <ItemsControl ItemsSource="{Binding Sections}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Classes="card">
                                    <StackPanel>
                                        <Border Classes="cardhead"><TextBlock Classes="cardtitle" Text="{Binding Title}"/></Border>
                                        <ItemsControl ItemsSource="{Binding Fields}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Classes="frow">
                                                        <Grid ColumnDefinitions="240,*">
                                                            <Border Classes="fcell"><TextBlock Classes="flabel" Text="{Binding Label}"/></Border>
                                                            <SelectableTextBlock Grid.Column="1" Classes="fvalue" Classes.empty="{Binding IsEmpty}" Text="{Binding Value}"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <ItemsControl ItemsSource="{Binding Lists}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Classes="frow">
                                                        <Grid ColumnDefinitions="240,*">
                                                            <Border Classes="fcell"><TextBlock Classes="flabel" Text="{Binding Name}"/></Border>
                                                            <StackPanel Grid.Column="1" Margin="14,7" Spacing="3">
                                                                <ItemsControl ItemsSource="{Binding Items}">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Grid ColumnDefinitions="16,*" Margin="0,1">
                                                                                <TextBlock Text="•" Foreground="#0B5394" FontWeight="Bold" FontSize="13"/>
                                                                                <SelectableTextBlock Grid.Column="1" Text="{Binding}" TextWrapping="Wrap" FontSize="13" Foreground="#1C2733"/>
                                                                            </Grid>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                                <TextBlock Text="Non renseigné" Foreground="#A0ABB6" FontStyle="Italic" FontSize="12"
                                                                           IsVisible="{Binding !Items.Count}"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Aucune rubrique n'est enregistrée dans cette fiche." Foreground="#6B7A89" FontStyle="Italic"
                               Margin="0,0,0,14" IsVisible="{Binding HasNoSections}"/>
                </StackPanel>
            </ScrollViewer>
        </Panel>

        <!-- Pied -->
        <Border Grid.Row="4" Background="White" BorderBrush="#C9D3DD" BorderThickness="0,1,0,0" Padding="18,7">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Foreground="#6B7A89" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                    <Run Text="Source : base eFiBi  ·  Fiche n° "/><Run Text="{Binding Id, Mode=OneWay}"/><Run Text="  ·  Code fiche "/><Run Text="{Binding FicheCode, Mode=OneWay}"/>
                </TextBlock>
                <Button Grid.Column="1" Classes="ef" Content="Revenir au registre" Command="{Binding CloseCommand}"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
