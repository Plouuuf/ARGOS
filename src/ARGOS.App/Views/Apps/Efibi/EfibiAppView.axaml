<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Argos.Views.Apps.Efibi.EfibiAppView"
             Background="#F2F4F7"
             FontFamily="Segoe UI, Helvetica Neue, Arial, Liberation Sans"
             Foreground="#1C2733">
    <!-- eFiBi : registre des fiches bilans (consultation). Aucun arrondi : présentation rectiligne façon logiciel métier. -->
    <UserControl.Resources>
        <!-- Neutralise les arrondis du thème (champs, listes déroulantes, calendrier, info-bulles) dans toute la vue. -->
        <CornerRadius x:Key="ControlCornerRadius">0</CornerRadius>
        <CornerRadius x:Key="OverlayCornerRadius">0</CornerRadius>
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- En-têtes de colonnes (tri) -->
        <Style Selector="Button.sort">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#2F3E4C"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
            <Setter Property="BorderBrush" Value="#D3DCE5"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.sort:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#E1E9F1"/>
            <Setter Property="Foreground" Value="#0B5394"/>
        </Style>
        <Style Selector="Button.sort:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#D3E0EC"/>
        </Style>
        <Style Selector="Button.sort TextBlock.h1">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style Selector="Button.sort TextBlock.h2">
            <Setter Property="FontSize" Value="9.5"/>
            <Setter Property="Foreground" Value="#7A8896"/>
        </Style>
        <Style Selector="Button.sort TextBlock.arrow">
            <Setter Property="FontSize" Value="8"/>
            <Setter Property="Foreground" Value="#8C99A6"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
        </Style>

        <!-- Champs -->
        <Style Selector="TextBox.ef">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#B9C5D1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="#1C2733"/>
        </Style>
        <Style Selector="ComboBox.ef">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#B9C5D1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="CalendarDatePicker.ef">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#B9C5D1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="CheckBox">
            <Setter Property="CornerRadius" Value="0"/>
        </Style>

        <!-- Boutons -->
        <Style Selector="Button.ef">
            <Setter Property="Background" Value="#0B5394"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#0B5394"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.ef:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#0E64B0"/>
            <Setter Property="BorderBrush" Value="#0E64B0"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.ef:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#08406F"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.ef.light">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#0B5394"/>
            <Setter Property="BorderBrush" Value="#B9C5D1"/>
        </Style>
        <Style Selector="Button.ef.light:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#EAF1F8"/>
            <Setter Property="BorderBrush" Value="#0B5394"/>
            <Setter Property="Foreground" Value="#0B5394"/>
        </Style>
        <Style Selector="Button.ef.light:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#DCE7F2"/>
            <Setter Property="Foreground" Value="#0B5394"/>
        </Style>
        <Style Selector="Button.ef:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#F2F4F7"/>
            <Setter Property="BorderBrush" Value="#D3DCE5"/>
            <Setter Property="Foreground" Value="#A3AEB9"/>
        </Style>

        <Style Selector="TextBlock.lbl">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#5B6B7B"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <!-- Lignes du registre : fond transparent (alternance portée par le conteneur), survol bleu pâle -->
        <Style Selector="Button.row">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Foreground" Value="#1C2733"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.row:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#E8F1FA"/>
            <Setter Property="Foreground" Value="#1C2733"/>
        </Style>
        <Style Selector="Button.row:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#D7E6F4"/>
            <Setter Property="Foreground" Value="#1C2733"/>
        </Style>
        <Style Selector="ItemsControl.reg ContentPresenter:nth-child(2n)">
            <Setter Property="Background" Value="#F6F8FA"/>
        </Style>
        <Style Selector="TextBlock.cell">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style Selector="TextBlock.sub">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#6B7A89"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
    </UserControl.Styles>

    <DockPanel>
        <!-- Bandeau -->
        <Border DockPanel.Dock="Top" Background="#0B5394" BorderBrush="#083F70" BorderThickness="0,0,0,1" Padding="18,10">
            <Grid ColumnDefinitions="Auto,12,*,Auto">
                <Border Background="White" Padding="4" VerticalAlignment="Center">
                    <Image Source="avares://ARGOS.App/Assets/Icons/efibi.png" Width="28" Height="28"/>
                </Border>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="eFiBi" Foreground="White" FontSize="18" FontWeight="Bold"/>
                    <TextBlock Text="Fiches bilans numériques · Registre des fiches" Foreground="#C9DCEE" FontSize="11.5"/>
                </StackPanel>
                <TextBlock Grid.Column="3" Text="{Binding ResultLabel}" Foreground="#C9DCEE" FontSize="12" FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>
        <Border DockPanel.Dock="Top" Background="#B3261E" IsVisible="{Binding HasError}" Padding="18,8">
            <TextBlock Text="{Binding Error}" Foreground="White" FontWeight="SemiBold" TextWrapping="Wrap"/>
        </Border>

        <!-- Recherche et filtres -->
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="#D3DCE5" BorderThickness="0,0,0,1" Padding="18,12">
            <StackPanel Spacing="12">
                <Grid ColumnDefinitions="*,10,210,10,Auto,8,Auto">
                    <TextBox Classes="ef" Text="{Binding Text}"
                             Watermark="Rechercher : n° d'intervention, nom ou prénom de la victime, identifiant, code de partage"/>
                    <ComboBox Grid.Column="2" Classes="ef" ItemsSource="{Binding Statuses}" SelectedItem="{Binding Status}"/>
                    <Button Grid.Column="4" Classes="ef light" Content="Recherche avancée" Command="{Binding ToggleAdvancedCommand}"/>
                    <Button Grid.Column="6" Classes="ef light" Content="Actualiser" Command="{Binding RefreshCommand}"/>
                </Grid>
                <Border Background="#F7F9FB" BorderBrush="#D3DCE5" BorderThickness="1" Padding="14,12" IsVisible="{Binding Advanced}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="RECHERCHE AVANCÉE" FontSize="11" FontWeight="Bold" Foreground="#0B5394"/>
                        <Grid ColumnDefinitions="*,10,*,10,120,10,120">
                            <StackPanel>
                                <TextBlock Classes="lbl" Text="N° D'INTERVENTION"/>
                                <TextBox Classes="ef" Text="{Binding Intervention}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Classes="lbl" Text="IDENTITÉ DE LA VICTIME"/>
                                <TextBox Classes="ef" Text="{Binding Victim}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Classes="lbl" Text="IDENTIFIANT"/>
                                <TextBox Classes="ef" Text="{Binding Identifier}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="6">
                                <TextBlock Classes="lbl" Text="CODE DE PARTAGE"/>
                                <TextBox Classes="ef" Text="{Binding ShareCode}"/>
                            </StackPanel>
                        </Grid>
                        <Grid ColumnDefinitions="170,10,170,16,Auto,*,Auto,8,Auto">
                            <StackPanel>
                                <TextBlock Classes="lbl" Text="DU"/>
                                <CalendarDatePicker Classes="ef" SelectedDate="{Binding From}" SelectedDateFormat="Custom"
                                                    CustomDateFormatString="dd/MM/yyyy" Watermark="jj/mm/aaaa"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Classes="lbl" Text="AU"/>
                                <CalendarDatePicker Classes="ef" SelectedDate="{Binding To}" SelectedDateFormat="Custom"
                                                    CustomDateFormatString="dd/MM/yyyy" Watermark="jj/mm/aaaa"/>
                            </StackPanel>
                            <CheckBox Grid.Column="4" Content="Plus anciennes d'abord" IsChecked="{Binding OldestFirst}" VerticalAlignment="Bottom"/>
                            <Button Grid.Column="6" Classes="ef light" Content="Réinitialiser" Command="{Binding ResetCommand}" VerticalAlignment="Bottom"/>
                            <Button Grid.Column="8" Classes="ef" Content="Rechercher" Command="{Binding SearchCommand}" VerticalAlignment="Bottom"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Pagination -->
        <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="#D3DCE5" BorderThickness="0,1,0,0" Padding="18,8">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                <TextBlock Text="{Binding ResultLabel}" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="#5B6B7B"/>
                <Button Grid.Column="1" Classes="ef light" Content="◀  Précédente" Command="{Binding PreviousCommand}"/>
                <Border Grid.Column="2" BorderBrush="#B9C5D1" BorderThickness="0,1" MinHeight="32" MinWidth="120" Background="#F7F9FB">
                    <TextBlock Text="{Binding PageLabel}" FontSize="12.5" FontWeight="SemiBold" Foreground="#2F3E4C"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12,0"/>
                </Border>
                <Button Grid.Column="3" Classes="ef light" Content="Suivante  ▶" Command="{Binding NextCommand}"/>
            </Grid>
        </Border>

        <!-- Registre -->
        <Border Margin="18,14,18,12" Background="White" BorderBrush="#C9D3DD" BorderThickness="1" ClipToBounds="True">
            <DockPanel>
                <Border DockPanel.Dock="Top" Background="#EEF2F6" BorderBrush="#0B5394" BorderThickness="0,0,0,2">
                    <Grid ColumnDefinitions="160,115,180,*,150">
                        <Button Classes="sort" Command="{Binding SortCommand}" CommandParameter="intervention" ToolTip.Tip="Trier par n° d'intervention">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel>
                                    <TextBlock Classes="h1" Text="N° INTERVENTION"/>
                                    <TextBlock Classes="h2" Text="Code fiche"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Classes="arrow" Text="▲▼"/>
                            </Grid>
                        </Button>
                        <Button Grid.Column="1" Classes="sort" Command="{Binding SortCommand}" CommandParameter="date" ToolTip.Tip="Trier par horodatage">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel>
                                    <TextBlock Classes="h1" Text="HORODATAGE"/>
                                    <TextBlock Classes="h2" Text="Date · heure"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Classes="arrow" Text="▲▼"/>
                            </Grid>
                        </Button>
                        <Button Grid.Column="2" Classes="sort" Command="{Binding SortCommand}" CommandParameter="author" ToolTip.Tip="Trier par auteur">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel>
                                    <TextBlock Classes="h1" Text="AUTEUR"/>
                                    <TextBlock Classes="h2" Text="Chef d'agrès"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Classes="arrow" Text="▲▼"/>
                            </Grid>
                        </Button>
                        <Button Grid.Column="3" Classes="sort" Command="{Binding SortCommand}" CommandParameter="circumstances" ToolTip.Tip="Trier par bilan circonstanciel">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel>
                                    <TextBlock Classes="h1" Text="BILAN CIRCONSTANCIEL"/>
                                    <TextBlock Classes="h2" Text="Observations"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Classes="arrow" Text="▲▼"/>
                            </Grid>
                        </Button>
                        <Button Grid.Column="4" Classes="sort" BorderThickness="0" Command="{Binding SortCommand}" CommandParameter="status" ToolTip.Tip="Trier par statut">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel>
                                    <TextBlock Classes="h1" Text="STATUT"/>
                                    <TextBlock Classes="h2" Text="Transmission"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Classes="arrow" Text="▲▼"/>
                            </Grid>
                        </Button>
                    </Grid>
                </Border>
                <Panel>
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl Classes="reg" ItemsSource="{Binding Items}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Classes="row" Command="{Binding OpenCommand}">
                                        <Border BorderBrush="#E1E7ED" BorderThickness="0,0,0,1" MinHeight="54" Padding="0,8">
                                            <Grid ColumnDefinitions="160,115,180,*,150">
                                                <!-- N° intervention / code fiche -->
                                                <StackPanel Margin="10,0" VerticalAlignment="Center">
                                                    <TextBlock Classes="cell" Text="{Binding Intervention}" FontWeight="Bold" Foreground="#0B5394" FontSize="13"/>
                                                    <TextBlock Classes="sub" Text="{Binding FicheCode}" FontFamily="Consolas, Menlo, DejaVu Sans Mono, monospace"
                                                               ToolTip.Tip="{Binding FicheTooltip}"/>
                                                </StackPanel>
                                                <!-- Date / heure -->
                                                <StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center">
                                                    <TextBlock Classes="cell" Text="{Binding Date}"/>
                                                    <TextBlock Classes="sub" Text="{Binding Time}" FontWeight="SemiBold" Foreground="#2F3E4C"/>
                                                </StackPanel>
                                                <!-- Auteur -->
                                                <TextBlock Grid.Column="2" Classes="cell" Text="{Binding Author}" Margin="10,0" VerticalAlignment="Center"
                                                           TextWrapping="Wrap" MaxLines="2" ToolTip.Tip="{Binding Author}"/>
                                                <!-- Bilan circonstanciel -->
                                                <TextBlock Grid.Column="3" Classes="cell" Text="{Binding Circumstances}" Margin="10,0" VerticalAlignment="Center"
                                                           TextWrapping="Wrap" MaxLines="2" Foreground="#2F3E4C" ToolTip.Tip="{Binding Circumstances}"/>
                                                <!-- Statut -->
                                                <Border Grid.Column="4" Margin="10,0" Background="{Binding StatusBrush}" Padding="8,5"
                                                        VerticalAlignment="Center" HorizontalAlignment="Stretch">
                                                    <TextBlock Text="{Binding Status}" Foreground="White" HorizontalAlignment="Center" TextAlignment="Center"
                                                               FontWeight="Bold" TextWrapping="Wrap" FontSize="10.5"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock Text="Aucune fiche bilan ne correspond aux critères." Foreground="#6B7A89" Margin="14" IsVisible="{Binding IsEmpty}"/>
                    <TextBlock Text="Chargement…" Foreground="#6B7A89" Margin="14" IsVisible="{Binding Loading}"/>
                </Panel>
            </DockPanel>
        </Border>
    </DockPanel>
</UserControl>
