<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Argos.Views.Apps.Sigtao.PlanningView">
    <!-- SIGTAO : planning de garde à la semaine ou au mois (DataContext = SigtaoAppViewModel). -->
    <DockPanel Margin="22,18">
        <StackPanel DockPanel.Dock="Top" Spacing="10">
            <TextBlock Classes="h1" Text="Planning de garde"/>
            <Border Classes="card" Padding="12,10">
                <Grid ColumnDefinitions="Auto,8,Auto,8,Auto,16,*,16,Auto,4,Auto,20,Auto,8,120">
                    <Button Classes="sg light" Content="◀" Padding="10,4" Command="{Binding PlanningPrevCommand}"/>
                    <Button Grid.Column="2" Classes="sg light" Content="▶" Padding="10,4" Command="{Binding PlanningNextCommand}"/>
                    <Button Grid.Column="4" Classes="sg light" Content="Aujourd'hui" Command="{Binding PlanningTodayCommand}"/>
                    <TextBlock Grid.Column="6" Text="{Binding PlanningTitle}" FontSize="15" FontWeight="SemiBold" Foreground="#13294B" VerticalAlignment="Center"/>
                    <Button Grid.Column="8" Classes="sg" Classes.light="{Binding !IsPlanningWeek}" Content="Semaine" Command="{Binding PlanningWeekCommand}"/>
                    <Button Grid.Column="10" Classes="sg" Classes.light="{Binding !IsPlanningMonth}" Content="Mois" Command="{Binding PlanningMonthCommand}"/>
                    <TextBlock Grid.Column="12" Classes="label" Text="CENTRE" VerticalAlignment="Center" Margin="0"/>
                    <ComboBox Grid.Column="14" Classes="sg" ItemsSource="{Binding PlanningCentres}" SelectedItem="{Binding PlanningCentre}" HorizontalAlignment="Stretch"/>
                </Grid>
            </Border>
            <WrapPanel>
                <Border Background="#DCE8F7" Width="14" Height="14" Margin="0,0,5,0" BorderBrush="#9AA6B4" BorderThickness="1"/>
                <TextBlock Text="Engin (garde validée)" FontSize="11.5" Margin="0,0,14,0"/>
                <Border Background="#E3D7F2" Width="14" Height="14" Margin="0,0,5,0" BorderBrush="#9AA6B4" BorderThickness="1"/>
                <TextBlock Text="Service / renfort" FontSize="11.5" Margin="0,0,14,0"/>
                <Border Background="#FFF4CE" Width="14" Height="14" Margin="0,0,5,0" BorderBrush="#9AA6B4" BorderThickness="1"/>
                <TextBlock Text="Garde en préparation" FontSize="11.5" Margin="0,0,14,0"/>
                <TextBlock Classes="muted" Text="{Binding PlanningSummary}"/>
            </WrapPanel>
        </StackPanel>

        <Border Classes="card" Padding="0" Margin="0,10,0,0">
            <ScrollViewer HorizontalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- En-tête : un bouton par jour (ouvre la feuille de garde) -->
                    <StackPanel Orientation="Horizontal">
                        <Border Width="230" Background="#13294B" Padding="10,6">
                            <TextBlock Text="MILITAIRE" Foreground="White" FontSize="11.5" FontWeight="Bold" VerticalAlignment="Center"/>
                        </Border>
                        <ItemsControl ItemsSource="{Binding PlanningDays}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Width="{Binding Width}" Background="{Binding Background}" Command="{Binding OpenCommand}" Padding="0,4"
                                            CornerRadius="0" BorderBrush="#FFFFFF" BorderThickness="0,0,1,0" HorizontalContentAlignment="Center"
                                            ToolTip.Tip="Ouvrir la feuille de garde de ce jour">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Top}" FontSize="10.5" Foreground="#4A5868" HorizontalAlignment="Center"/>
                                            <TextBlock Text="{Binding Bottom}" FontSize="12.5" FontWeight="Bold" Foreground="#13294B" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border Width="54" Background="#13294B" Padding="4,6">
                            <TextBlock Text="TOTAL" Foreground="White" FontSize="10.5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding PlanningRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="230" BorderBrush="#E1E6EC" BorderThickness="0,0,1,1" Padding="10,5">
                                        <TextBlock FontSize="12" TextTrimming="CharacterEllipsis" Foreground="#1D2733">
                                            <Run Text="{Binding Grade}" FontWeight="SemiBold" Foreground="#4A5868"/><Run Text=" "/><Run Text="{Binding Name}"/>
                                        </TextBlock>
                                    </Border>
                                    <ItemsControl ItemsSource="{Binding Cells}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Width="{Binding Width}" Background="{Binding Background}" BorderBrush="#E1E6EC" BorderThickness="0,0,1,1"
                                                        Padding="2,5" ToolTip.Tip="{Binding Tip}">
                                                    <TextBlock Text="{Binding Text}" Foreground="{Binding Foreground}" FontSize="11" FontWeight="SemiBold"
                                                               HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Border Width="54" BorderBrush="#E1E6EC" BorderThickness="0,0,0,1" Padding="2,5">
                                        <TextBlock Text="{Binding Total}" FontSize="12" FontWeight="Bold" Foreground="#13294B" HorizontalAlignment="Center"/>
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <!-- Effectif par jour -->
                    <StackPanel Orientation="Horizontal">
                        <Border Width="230" Background="#EEF1F5" BorderBrush="#E1E6EC" BorderThickness="0,0,1,1" Padding="10,5">
                            <TextBlock Text="Effectif de garde" FontSize="12" FontWeight="Bold" Foreground="#13294B"/>
                        </Border>
                        <ItemsControl ItemsSource="{Binding PlanningTotals}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="{Binding Width}" Background="{Binding Background}" BorderBrush="#E1E6EC" BorderThickness="0,0,1,1"
                                            Padding="2,5" ToolTip.Tip="{Binding Tip}">
                                        <TextBlock Text="{Binding Text}" Foreground="{Binding Foreground}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <TextBlock Classes="muted" Text="Aucun militaire en activité." Margin="12,10" IsVisible="{Binding !PlanningRows.Count}"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </DockPanel>
</UserControl>
