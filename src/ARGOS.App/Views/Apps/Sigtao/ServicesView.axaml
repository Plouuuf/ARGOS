<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Argos.Views.Apps.Sigtao.ServicesView">
    <!-- SIGTAO : services de la compagnie et leurs membres (DataContext = SigtaoAppViewModel). -->
    <DockPanel Margin="22,18">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Classes="h1" Text="Services de la compagnie"/>
            <TextBlock Classes="muted" Margin="0,-6,0,12" TextWrapping="Wrap"
                       Text="Choisis un service pour voir les militaires affectés et leur rôle. Un militaire peut appartenir à plusieurs services."/>
        </StackPanel>

        <Grid ColumnDefinitions="280,16,*">
            <!-- ===== Liste des services ===== -->
            <Border Classes="card" Padding="0" VerticalAlignment="Top">
                <StackPanel>
                    <Border Classes="thead">
                        <TextBlock Text="Services"/>
                    </Border>
                    <ItemsControl ItemsSource="{Binding ServicesList}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Classes="trow" Command="{Binding OpenCommand}" Padding="0">
                                    <Grid ColumnDefinitions="4,*">
                                        <Border Background="#C8102E" IsVisible="{Binding IsSelected}"/>
                                        <StackPanel Grid.Column="1" Margin="10,9,10,9" Spacing="2">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Text="{Binding Label}" FontSize="13" FontWeight="SemiBold" Foreground="#13294B"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <Border Grid.Column="1" Background="#E3ECF8" CornerRadius="9" Padding="7,1" Margin="8,0,0,0">
                                                    <TextBlock Text="{Binding Count}" FontSize="11.5" FontWeight="Bold" Foreground="#1F5FAD"/>
                                                </Border>
                                            </Grid>
                                            <TextBlock Text="{Binding Roles}" FontSize="11" Foreground="#5E6B7A" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ===== Aucun service choisi ===== -->
            <Border Grid.Column="2" Classes="card" VerticalAlignment="Top" IsVisible="{Binding !HasSelectedService}">
                <TextBlock Classes="muted" Text="Sélectionne un service dans la liste." Margin="0,4"/>
            </Border>

            <!-- ===== Membres du service choisi ===== -->
            <DockPanel Grid.Column="2" IsVisible="{Binding HasSelectedService}">
                <StackPanel DockPanel.Dock="Top">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Classes="h2" Text="{Binding SelectedServiceTitle}" FontSize="16"/>
                        <TextBlock Grid.Column="1" Classes="muted" Text="{Binding ServiceMembersCount}" VerticalAlignment="Top"/>
                    </Grid>

                    <!-- Ajout d'un militaire (gestion de la compagnie) -->
                    <Border Classes="card" BorderBrush="#1F5FAD" IsVisible="{Binding CanEditServices}">
                        <Grid ColumnDefinitions="*,10,220,10,Auto">
                            <StackPanel>
                                <TextBlock Classes="label" Text="MILITAIRE (DOSSIERS EN ACTIVITÉ)"/>
                                <ComboBox Classes="sg" ItemsSource="{Binding ServiceCandidates}" SelectedItem="{Binding ServiceNewMember}"
                                          PlaceholderText="Choisir le militaire"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Classes="label" Text="RÔLE DANS LE SERVICE"/>
                                <ComboBox Classes="sg" ItemsSource="{Binding ServiceRoles}" SelectedItem="{Binding ServiceNewRole}"
                                          PlaceholderText="Choisir le rôle"/>
                            </StackPanel>
                            <Button Grid.Column="4" Classes="sg" Content="Ajouter au service" VerticalAlignment="Bottom"
                                    Command="{Binding ServiceAddCommand}"/>
                        </Grid>
                    </Border>
                </StackPanel>

                <Border Classes="card" Padding="0">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Classes="thead">
                            <Grid ColumnDefinitions="150,*,230,*,90">
                                <TextBlock Text="Grade"/>
                                <TextBlock Grid.Column="1" Text="Nom"/>
                                <TextBlock Grid.Column="2" Text="Rôle dans le service"/>
                                <TextBlock Grid.Column="3" Text="Observations" IsVisible="{Binding SelectedServiceHasObservations}"/>
                                <TextBlock Grid.Column="4" Text=""/>
                            </Grid>
                        </Border>
                        <ScrollViewer>
                            <StackPanel>
                                <ItemsControl ItemsSource="{Binding ServiceMembers}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#E7EBF0" BorderThickness="0,0,0,1" Padding="10,6">
                                                <Grid ColumnDefinitions="150,*,230,*,90">
                                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                        <Image Source="{Binding GradeIcon}" Width="22" Height="22"/>
                                                        <TextBlock Classes="cell" Text="{Binding GradeShort}" FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Classes="cell" Text="{Binding Name}" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding Status}" FontSize="11" Foreground="#C62828" IsVisible="{Binding IsInactive}"/>
                                                    </StackPanel>
                                                    <Panel Grid.Column="2" Margin="0,0,10,0" VerticalAlignment="Center">
                                                        <ComboBox Classes="sg" ItemsSource="{Binding Roles}" SelectedItem="{Binding Role}"
                                                                  IsVisible="{Binding CanEdit}"/>
                                                        <TextBlock Classes="cell" Text="{Binding Role}" IsVisible="{Binding IsReadOnly}"/>
                                                    </Panel>
                                                    <!-- Casernement uniquement : texte libre ; « Enregistrer » apparaît après modification. -->
                                                    <Grid Grid.Column="3" ColumnDefinitions="*,Auto" Margin="0,0,10,0" VerticalAlignment="Center"
                                                          IsVisible="{Binding HasObservations}">
                                                        <TextBox Classes="sg" Text="{Binding Observations}" IsReadOnly="{Binding IsReadOnly}"
                                                                 AcceptsReturn="True" TextWrapping="Wrap" Watermark="Observations"/>
                                                        <Button Grid.Column="1" Classes="sg" Content="Enregistrer" Padding="8,4" FontSize="11.5" Margin="6,0,0,0"
                                                                VerticalAlignment="Center" Command="{Binding SaveObservationsCommand}"
                                                                IsVisible="{Binding ObservationsDirty}"/>
                                                    </Grid>
                                                    <Button Grid.Column="4" Classes="sg light" Content="Retirer" Padding="10,4" FontSize="12"
                                                            HorizontalAlignment="Right" VerticalAlignment="Center"
                                                            Command="{Binding RemoveCommand}" IsVisible="{Binding CanEdit}"
                                                            ToolTip.Tip="Retirer ce militaire du service"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Classes="muted" Text="Aucun militaire affecté à ce service." Margin="16,10"
                                           IsVisible="{Binding !HasServiceMembers}"/>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>
