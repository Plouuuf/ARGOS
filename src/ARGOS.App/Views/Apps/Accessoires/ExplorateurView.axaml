<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Argos.Views.Apps.Accessoires.ExplorateurView"
             Classes="w10" Background="White"
             FontFamily="Segoe UI, Helvetica Neue, Arial, Liberation Sans" Foreground="#1A1A1A">
    <DockPanel>
        <!-- Ruban (onglet Accueil) -->
        <Border DockPanel.Dock="Top" Background="#F5F6F7" BorderBrush="#DADBDC" BorderThickness="0,0,0,1" Padding="6,4">
            <WrapPanel>
                <Button Classes="tool" Content="Nouveau dossier" Command="{Binding NewFolderCommand}"/>
                <Button Classes="tool" Content="Nouveau document texte" Command="{Binding NewTextCommand}"/>
                <Rectangle Width="1" Fill="#DADBDC" Margin="4,2"/>
                <Button Classes="tool" Content="Ouvrir" Command="{Binding OpenCommand}"/>
                <Button Classes="tool" Content="Renommer" Command="{Binding RenameCommand}"/>
                <Button Classes="tool" Content="Supprimer" Command="{Binding DeleteCommand}"/>
                <Rectangle Width="1" Fill="#DADBDC" Margin="4,2"/>
                <Button Classes="tool" Content="Copier" Command="{Binding CopyCommand}"/>
                <Button Classes="tool" Content="Couper" Command="{Binding CutCommand}"/>
                <Button Classes="tool" Content="Coller" Command="{Binding PasteCommand}"/>
                <Button Classes="tool" Content="Propriétés" Command="{Binding PropertiesCommand}"/>
                <Button Classes="tool" Content="Corbeille" Command="{Binding OpenTrashCommand}"/>
                <Rectangle Width="1" Fill="#DADBDC" Margin="4,2"/>
                <Button Classes="tool" Name="ImportButton" Content="Importer depuis le poste…"/>
                <Button Classes="tool" Name="DownloadButton" Content="Télécharger sur le poste…"/>
                <Rectangle Width="1" Fill="#DADBDC" Margin="4,2"/>
                <TextBlock Text="Déplacer vers" FontSize="12" VerticalAlignment="Center" Margin="6,0"/>
                <ComboBox ItemsSource="{Binding MoveTargets}" SelectedItem="{Binding MoveTarget}" MinWidth="150" FontSize="12" VerticalAlignment="Center">
                    <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" Margin="{Binding Indent}"/></DataTemplate></ComboBox.ItemTemplate>
                </ComboBox>
                <Button Classes="tool" Content="Déplacer" Command="{Binding MoveCommand}"/>
            </WrapPanel>
        </Border>
        <!-- Barre d'adresse -->
        <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,Auto,*,220" Margin="6,6">
            <Button Classes="tool" Content="←" FontSize="15" Padding="8,0" Command="{Binding BackCommand}" ToolTip.Tip="Précédent"/>
            <Button Grid.Column="1" Classes="tool" Content="↑" FontSize="15" Padding="8,0" Command="{Binding UpCommand}" ToolTip.Tip="Dossier parent"/>
            <Border Grid.Column="2" BorderBrush="#D9D9D9" BorderThickness="1" Padding="8,4" Margin="6,0">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Image Source="avares://ARGOS.App/Assets/Icons/explorateur.png" Width="16" Height="16"/>
                    <TextBlock Text="{Binding PathText}" FontSize="12.5" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
            <TextBox Grid.Column="3" Text="{Binding Search}" Watermark="Rechercher dans le dossier" FontSize="12" BorderBrush="#D9D9D9" CornerRadius="0" MinHeight="26"/>
        </Grid>
        <!-- Barre d'état -->
        <Border DockPanel.Dock="Bottom" BorderBrush="#F0F0F0" BorderThickness="0,1,0,0" Padding="10,3">
            <Grid ColumnDefinitions="*,Auto,16,Auto,8,120">
                <TextBlock Classes="status" Text="{Binding StatusText}"/>
                <TextBlock Grid.Column="1" Classes="status" Text="{Binding ClipboardText}" Foreground="#0063B1"/>
                <TextBlock Grid.Column="3" Classes="status" Text="{Binding QuotaText}" Foreground="#6D6D6D"/>
                <ProgressBar Grid.Column="5" MinWidth="0" Minimum="0" Maximum="1" Value="{Binding QuotaRatio}" Height="8" Foreground="#26A0DA" Background="#E6E6E6" VerticalAlignment="Center"/>
            </Grid>
        </Border>
        <Border DockPanel.Dock="Bottom" Padding="10,6" IsVisible="{Binding HasMessage}" Classes.err="{Binding MessageIsError}">
            <Border.Styles>
                <Style Selector="Border"><Setter Property="Background" Value="#E5F3FF"/></Style>
                <Style Selector="Border.err"><Setter Property="Background" Value="#FDE7E9"/></Style>
            </Border.Styles>
            <TextBlock Text="{Binding Message}" FontSize="12" TextWrapping="Wrap"/>
        </Border>
        <!-- Propriétés -->
        <Border DockPanel.Dock="Bottom" Background="#F5F6F7" BorderBrush="#DADBDC" BorderThickness="0,1,0,0" Padding="12,8" IsVisible="{Binding ShowProperties}">
            <StackPanel Spacing="2">
                <TextBlock Text="Propriétés" FontWeight="SemiBold" FontSize="13"/>
                <ItemsControl ItemsSource="{Binding Properties}">
                    <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" FontSize="12" TextWrapping="Wrap"/></DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
        <!-- Renommer -->
        <Border DockPanel.Dock="Bottom" Background="#F5F6F7" BorderBrush="#DADBDC" BorderThickness="0,1,0,0" Padding="10,6" IsVisible="{Binding IsRenaming}">
            <Grid ColumnDefinitions="Auto,8,*,8,Auto,4,Auto">
                <TextBlock Text="Nouveau nom" FontSize="12" VerticalAlignment="Center"/>
                <TextBox Grid.Column="2" Name="RenameBox" Text="{Binding RenameText}" FontSize="12.5" CornerRadius="0"/>
                <Button Grid.Column="4" Classes="tool" Content="OK" Command="{Binding ConfirmRenameCommand}" IsDefault="True"/>
                <Button Grid.Column="6" Classes="tool" Content="Annuler" Command="{Binding CancelRenameCommand}"/>
            </Grid>
        </Border>

        <Grid ColumnDefinitions="210,*">
            <!-- Volet de navigation -->
            <Border BorderBrush="#F0F0F0" BorderThickness="0,0,1,0">
                <ScrollViewer>
                    <StackPanel Margin="0,6">
                        <TextBlock Text="Accès rapide" FontSize="12" Foreground="#6D6D6D" Margin="12,2,0,4"/>
                        <ItemsControl ItemsSource="{Binding Folders}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Classes="row" Classes.selected="{Binding Selected}" Command="{Binding SelectCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="{Binding Indent}">
                                            <Image Source="avares://ARGOS.App/Assets/Icons/explorateur.png" Width="16" Height="16"/>
                                            <TextBlock Text="{Binding Name}" FontSize="12.5" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>
            <!-- Vue « Détails » -->
            <DockPanel Grid.Column="1">
                <Grid DockPanel.Dock="Top" ColumnDefinitions="*,140,150,90" Margin="12,6,12,2">
                    <TextBlock Classes="head" Text="Nom" Margin="26,0,0,0"/>
                    <TextBlock Grid.Column="1" Classes="head" Text="Modifié le"/>
                    <TextBlock Grid.Column="2" Classes="head" Text="Type"/>
                    <TextBlock Grid.Column="3" Classes="head" Text="Taille" HorizontalAlignment="Right"/>
                </Grid>
                <!-- Ce PC : dossiers de Windows et lecteur -->
                <StackPanel DockPanel.Dock="Top" Margin="12,4,12,8" IsVisible="{Binding ShowThisPc}">
                    <TextBlock Text="Dossiers" FontSize="12" Foreground="#1E3287" Margin="0,0,0,6"/>
                    <ItemsControl ItemsSource="{Binding SpecialFolders}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Classes="row" Width="200" Margin="0,0,8,6" Command="{Binding SelectCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="4">
                                        <Image Source="avares://ARGOS.App/Assets/Icons/explorateur.png" Width="36" Height="36"/>
                                        <TextBlock Text="{Binding Name}" FontSize="13" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Périphériques et lecteurs" FontSize="12" Foreground="#1E3287" Margin="0,8,0,6"/>
                    <Border Width="260" HorizontalAlignment="Left" Padding="6">
                        <Grid ColumnDefinitions="Auto,10,*">
                            <PathIcon Data="{StaticResource IconWindows}" Width="30" Height="30" Foreground="#0078D7"/>
                            <StackPanel Grid.Column="2" Spacing="3">
                                <TextBlock Text="Disque ARGOS (C:)" FontSize="13"/>
                                <ProgressBar MinWidth="0" Minimum="0" Maximum="1" Value="{Binding QuotaRatio}" Height="12" Foreground="#26A0DA" Background="#E6E6E6"/>
                                <TextBlock Text="{Binding QuotaText}" FontSize="11.5" Foreground="#6D6D6D"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <TextBlock Text="Autres éléments" FontSize="12" Foreground="#1E3287" Margin="0,10,0,0"/>
                </StackPanel>
                <Panel>
                    <TextBlock Text="Ce dossier est vide." FontSize="12" Foreground="#6D6D6D" HorizontalAlignment="Center" Margin="0,30,0,0" IsVisible="{Binding !HasItems}"/>
                    <ScrollViewer>
                        <ItemsControl ItemsSource="{Binding Items}" Margin="8,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Classes="row" Classes.selected="{Binding Selected}" Command="{Binding SelectCommand}" DoubleTapped="OnItemDoubleTapped">
                                        <Grid ColumnDefinitions="*,140,150,90">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Panel Width="18" Height="18">
                                                    <Image Source="avares://ARGOS.App/Assets/Icons/explorateur.png" IsVisible="{Binding IsFolder}"/>
                                                    <Path Data="{StaticResource W10File}" Stroke="#7A8594" StrokeThickness="1.4" Fill="White" Stretch="Uniform"
                                                          IsVisible="{Binding !IsFolder}"/>
                                                </Panel>
                                                <TextBlock Text="{Binding Name}" FontSize="12.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Classes="cell" Text="{Binding Modified}"/>
                                            <TextBlock Grid.Column="2" Classes="cell" Text="{Binding Type}"/>
                                            <TextBlock Grid.Column="3" Classes="cell" Text="{Binding Size}" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Panel>
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>
