<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Argos.Views.Apps.Accessoires.CalculatriceView"
             Classes="calc" Background="#E6E6E6" Focusable="True"
             FontFamily="Segoe UI, Helvetica Neue, Arial, Liberation Sans" Foreground="#1A1A1A">
    <DockPanel>
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="14,10,6,0">
            <TextBlock Text="Standard" FontSize="20" FontWeight="SemiBold"/>
            <ToggleButton Grid.Column="1" Classes="m" IsChecked="{Binding ShowHistory}" ToolTip.Tip="Historique" Background="Transparent" Padding="8,4">
                <TextBlock Text="Historique" FontSize="12"/>
            </ToggleButton>
        </Grid>
        <StackPanel DockPanel.Dock="Top" Margin="12,8,14,4">
            <TextBlock Text="{Binding Expression}" FontSize="13" Foreground="#6D6D6D" HorizontalAlignment="Right" MinHeight="18" TextTrimming="CharacterEllipsis"/>
            <Viewbox HorizontalAlignment="Right" StretchDirection="DownOnly" MaxHeight="64">
                <TextBlock Text="{Binding Display}" FontSize="46" FontWeight="SemiBold"/>
            </Viewbox>
            <TextBlock Text="{Binding MemoryText}" FontSize="11" Foreground="#6D6D6D" HorizontalAlignment="Right" MinHeight="14"/>
        </StackPanel>
        <UniformGrid DockPanel.Dock="Top" Columns="5" Height="30" Margin="4,0">
            <Button Classes="m" Content="MC" Command="{Binding MemoryCommand}" CommandParameter="MC" IsEnabled="{Binding HasMemory}"/>
            <Button Classes="m" Content="MR" Command="{Binding MemoryCommand}" CommandParameter="MR" IsEnabled="{Binding HasMemory}"/>
            <Button Classes="m" Content="M+" Command="{Binding MemoryCommand}" CommandParameter="M+"/>
            <Button Classes="m" Content="M-" Command="{Binding MemoryCommand}" CommandParameter="M-"/>
            <Button Classes="m" Content="MS" Command="{Binding MemoryCommand}" CommandParameter="MS"/>
        </UniformGrid>
        <Panel>
        <UniformGrid Columns="4" Rows="6" Margin="3,4,3,3">
            <Button Classes="k" Content="%" Command="{Binding PercentCommand}"/>
            <Button Classes="k" Content="CE" Command="{Binding ClearEntryCommand}"/>
            <Button Classes="k" Content="C" Command="{Binding ClearCommand}"/>
            <Button Classes="k" Content="⌫" Command="{Binding BackspaceCommand}"/>
            <Button Classes="k" Content="¹/x" Command="{Binding FunctionCommand}" CommandParameter="inv"/>
            <Button Classes="k" Content="x²" Command="{Binding FunctionCommand}" CommandParameter="sqr"/>
            <Button Classes="k" Content="²√x" Command="{Binding FunctionCommand}" CommandParameter="sqrt"/>
            <Button Classes="k" Content="÷" Command="{Binding OperatorCommand}" CommandParameter="÷"/>
            <Button Classes="k num" Content="7" Command="{Binding DigitCommand}" CommandParameter="7"/>
            <Button Classes="k num" Content="8" Command="{Binding DigitCommand}" CommandParameter="8"/>
            <Button Classes="k num" Content="9" Command="{Binding DigitCommand}" CommandParameter="9"/>
            <Button Classes="k" Content="×" Command="{Binding OperatorCommand}" CommandParameter="×"/>
            <Button Classes="k num" Content="4" Command="{Binding DigitCommand}" CommandParameter="4"/>
            <Button Classes="k num" Content="5" Command="{Binding DigitCommand}" CommandParameter="5"/>
            <Button Classes="k num" Content="6" Command="{Binding DigitCommand}" CommandParameter="6"/>
            <Button Classes="k" Content="−" Command="{Binding OperatorCommand}" CommandParameter="−"/>
            <Button Classes="k num" Content="1" Command="{Binding DigitCommand}" CommandParameter="1"/>
            <Button Classes="k num" Content="2" Command="{Binding DigitCommand}" CommandParameter="2"/>
            <Button Classes="k num" Content="3" Command="{Binding DigitCommand}" CommandParameter="3"/>
            <Button Classes="k" Content="+" Command="{Binding OperatorCommand}" CommandParameter="+"/>
            <Button Classes="k num" Content="±" Command="{Binding NegateCommand}"/>
            <Button Classes="k num" Content="0" Command="{Binding DigitCommand}" CommandParameter="0"/>
            <Button Classes="k num" Content="," Command="{Binding DecimalCommand}"/>
            <Button Classes="k eq" Content="=" Command="{Binding EqualsCommand}" Background="#8ABAE6"/>
        </UniformGrid>
        <!-- Historique : cliquer un calcul réutilise son résultat -->
        <Border Background="#F2F2F2" IsVisible="{Binding ShowHistory}" BorderBrush="#D9D9D9" BorderThickness="0,1,0,0">
            <DockPanel>
                <Button DockPanel.Dock="Bottom" Classes="m" HorizontalAlignment="Right" Margin="6" Content="Effacer l'historique"
                        Command="{Binding ClearHistoryCommand}" IsEnabled="{Binding HasHistory}"/>
                <Panel>
                    <TextBlock Text="Il n'y a pas encore d'historique." FontSize="13" Foreground="#6D6D6D" Margin="14"
                               IsVisible="{Binding !HasHistory}"/>
                    <ScrollViewer>
                        <ItemsControl ItemsSource="{Binding History}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Classes="m" HorizontalContentAlignment="Right" Padding="14,8" Command="{Binding ReuseCommand}">
                                        <StackPanel HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding Expression}" FontSize="12" Foreground="#6D6D6D" HorizontalAlignment="Right" FontWeight="Normal"/>
                                            <TextBlock Text="{Binding Result}" FontSize="20" HorizontalAlignment="Right"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Panel>
            </DockPanel>
        </Border>
        </Panel>
    </DockPanel>
</UserControl>
