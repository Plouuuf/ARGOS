<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m="using:Argos.Views.Mobile"
             x:Class="Argos.Views.Mobile.Ilias.FormationMobileView"
             Classes="ios"
             m:MobilePage.IsNative="True"
             m:MobilePage.Accent="#0C3C78">
    <!-- Formation ILIAS sur iPhone (même modèle que la version bureau : FormationViewModel). -->
    <UserControl.Resources>
        <SolidColorBrush x:Key="AppAccent" Color="#0C3C78"/>
    </UserControl.Resources>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,0,24">
            <TextBlock Classes="footnote" Text="FORMATION" FontWeight="SemiBold" Margin="16,10,16,0"/>
            <TextBlock Classes="large" Text="{Binding Title}" Margin="16,2,16,6"/>
            <TextBlock Classes="footnote" Text="{Binding Description}" Margin="16,0,16,4"
                       IsVisible="{Binding Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

            <TextBlock Classes="section" Text="PROGRESSION"/>
            <Border Classes="group">
                <Border Classes="row">
                    <StackPanel Spacing="6">
                        <Grid ColumnDefinitions="*,Auto">
                            <ProgressBar Minimum="0" Maximum="1" Value="{Binding Progress}" Height="8" MinHeight="8" CornerRadius="4"
                                         Foreground="#0C3C78" Background="#E5E5EA" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Classes="caption" Text="{Binding ProgressLabel}" Margin="12,0,0,0"/>
                        </Grid>
                        <TextBlock Text="{Binding State}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource AppAccent}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Border>

            <TextBlock Classes="section" Text="OBJECTIFS"/>
            <Border Classes="group">
                <Border Classes="row">
                    <TextBlock Text="{Binding Objectives}" FontSize="15" TextWrapping="Wrap"/>
                </Border>
            </Border>

            <TextBlock Classes="section" Text="PRÉREQUIS"/>
            <Border Classes="group">
                <Border Classes="row">
                    <TextBlock Text="{Binding Prerequisites}" FontSize="15" TextWrapping="Wrap"/>
                </Border>
            </Border>

            <TextBlock Classes="section" Text="MODULES"/>
            <ItemsControl ItemsSource="{Binding Modules}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Classes="group" Margin="16,0,16,10">
                            <StackPanel>
                                <Border Classes="row">
                                    <StackPanel Spacing="4">
                                        <TextBlock Classes="title" Text="{Binding Title}" TextWrapping="Wrap" TextTrimming="None"/>
                                        <TextBlock Text="{Binding Content}" FontSize="14.5" Foreground="#3C3C43" TextWrapping="Wrap"
                                                   IsVisible="{Binding Content, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                    </StackPanel>
                                </Border>
                                <Button Classes="row" Command="{Binding OpenDocumentCommand}" IsVisible="{Binding HasDocument}">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <PathIcon Data="{StaticResource TabDocument}" Width="18" Height="18" Foreground="{DynamicResource AppAccent}" Margin="0,0,12,0"/>
                                        <TextBlock Grid.Column="1" Classes="label" Text="Ouvrir le document du module" Foreground="{DynamicResource AppAccent}"/>
                                        <TextBlock Grid.Column="2" Classes="chevron"/>
                                    </Grid>
                                </Button>
                                <Border Classes="row">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Classes="label" Text="Module terminé"/>
                                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding Done}" OnContent="" OffContent="" MinWidth="0" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Border Classes="group" IsVisible="{Binding !Modules.Count}">
                <Border Classes="row">
                    <TextBlock Classes="value" Text="Aucun module."/>
                </Border>
            </Border>

            <StackPanel IsVisible="{Binding HasQuiz}">
                <TextBlock Classes="section" Text="ÉVALUATION FINALE"/>
                <Border Classes="group">
                    <Border Classes="row">
                        <TextBlock Classes="label" Text="{Binding QuizTitle}" TextWrapping="Wrap"/>
                    </Border>
                </Border>
                <Button Classes="primary" Content="Passer l'évaluation" Command="{Binding StartQuizCommand}" Margin="16,12,16,6"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
