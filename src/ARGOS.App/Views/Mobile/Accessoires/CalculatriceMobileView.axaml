<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m="using:Argos.Views.Mobile"
             x:Class="Argos.Views.Mobile.Accessoires.CalculatriceMobileView"
             Classes="ios" Background="Black" Focusable="True"
             m:MobilePage.IsNative="True"
             m:MobilePage.Accent="#0078D7">
    <!-- Calculatrice sur iPhone : touches rondes (même modèle que la version bureau : CalculatriceViewModel). -->
    <UserControl.Resources>
        <SolidColorBrush x:Key="AppAccent" Color="#0078D7"/>
    </UserControl.Resources>
    <UserControl.Styles>
        <Style Selector="Button.key">
            <Setter Property="Width" Value="76"/>
            <Setter Property="Height" Value="76"/>
            <Setter Property="CornerRadius" Value="38"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="#333333"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="32"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.key:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#333333"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.key.fn">
            <Setter Property="Background" Value="#A5A5A5"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="FontSize" Value="25"/>
        </Style>
        <Style Selector="Button.key.fn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#A5A5A5"/>
            <Setter Property="Foreground" Value="Black"/>
        </Style>
        <Style Selector="Button.key.op">
            <Setter Property="Background" Value="{DynamicResource AppAccent}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="36"/>
        </Style>
        <Style Selector="Button.key.op:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppAccent}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.key:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Opacity" Value="0.65"/>
        </Style>
        <Style Selector="Button.mem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="0,8"/>
        </Style>
        <Style Selector="Button.mem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#1C1C1E"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.mem:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#636366"/>
        </Style>
        <Style Selector="ToggleButton.hist">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource AppAccent}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="CornerRadius" Value="16"/>
        </Style>
        <Style Selector="ToggleButton.hist:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource AppAccent}"/>
        </Style>
        <Style Selector="ToggleButton.hist:checked /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppAccent}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*,Auto,3*">
        <Grid ColumnDefinitions="*,Auto" Margin="12,6,12,0">
            <ToggleButton Grid.Column="1" Classes="hist" IsChecked="{Binding ShowHistory}" Content="Historique"/>
        </Grid>

        <!-- Affichage -->
        <StackPanel Grid.Row="1" VerticalAlignment="Bottom" Margin="22,0,22,4">
            <TextBlock Text="{Binding Expression}" FontSize="18" Foreground="#8E8E93" HorizontalAlignment="Right" MinHeight="22" TextTrimming="CharacterEllipsis"/>
            <Viewbox HorizontalAlignment="Right" StretchDirection="DownOnly" MaxHeight="96">
                <TextBlock Text="{Binding Display}" FontSize="80" FontWeight="Light" Foreground="White"/>
            </Viewbox>
            <TextBlock Text="{Binding MemoryText}" FontSize="13" Foreground="#8E8E93" HorizontalAlignment="Right" MinHeight="16"/>
        </StackPanel>

        <!-- Mémoire -->
        <UniformGrid Grid.Row="2" Columns="5" Margin="10,0">
            <Button Classes="mem" Content="MC" Command="{Binding MemoryCommand}" CommandParameter="MC" IsEnabled="{Binding HasMemory}"/>
            <Button Classes="mem" Content="MR" Command="{Binding MemoryCommand}" CommandParameter="MR" IsEnabled="{Binding HasMemory}"/>
            <Button Classes="mem" Content="M+" Command="{Binding MemoryCommand}" CommandParameter="M+"/>
            <Button Classes="mem" Content="M-" Command="{Binding MemoryCommand}" CommandParameter="M-"/>
            <Button Classes="mem" Content="MS" Command="{Binding MemoryCommand}" CommandParameter="MS"/>
        </UniformGrid>

        <!-- Clavier rond, mis à l'échelle de l'écran -->
        <Viewbox Grid.Row="3" Stretch="Uniform" StretchDirection="DownOnly" VerticalAlignment="Top" Margin="8,4,8,14">
            <UniformGrid Columns="4" Rows="6">
                <Button Classes="key fn" Content="%" Command="{Binding PercentCommand}"/>
                <Button Classes="key fn" Content="CE" Command="{Binding ClearEntryCommand}"/>
                <Button Classes="key fn" Content="C" Command="{Binding ClearCommand}"/>
                <Button Classes="key fn" Content="⌫" Command="{Binding BackspaceCommand}"/>
                <Button Classes="key fn" Content="¹/x" Command="{Binding FunctionCommand}" CommandParameter="inv"/>
                <Button Classes="key fn" Content="x²" Command="{Binding FunctionCommand}" CommandParameter="sqr"/>
                <Button Classes="key fn" Content="√x" Command="{Binding FunctionCommand}" CommandParameter="sqrt"/>
                <Button Classes="key op" Content="÷" Command="{Binding OperatorCommand}" CommandParameter="÷"/>
                <Button Classes="key" Content="7" Command="{Binding DigitCommand}" CommandParameter="7"/>
                <Button Classes="key" Content="8" Command="{Binding DigitCommand}" CommandParameter="8"/>
                <Button Classes="key" Content="9" Command="{Binding DigitCommand}" CommandParameter="9"/>
                <Button Classes="key op" Content="×" Command="{Binding OperatorCommand}" CommandParameter="×"/>
                <Button Classes="key" Content="4" Command="{Binding DigitCommand}" CommandParameter="4"/>
                <Button Classes="key" Content="5" Command="{Binding DigitCommand}" CommandParameter="5"/>
                <Button Classes="key" Content="6" Command="{Binding DigitCommand}" CommandParameter="6"/>
                <Button Classes="key op" Content="−" Command="{Binding OperatorCommand}" CommandParameter="−"/>
                <Button Classes="key" Content="1" Command="{Binding DigitCommand}" CommandParameter="1"/>
                <Button Classes="key" Content="2" Command="{Binding DigitCommand}" CommandParameter="2"/>
                <Button Classes="key" Content="3" Command="{Binding DigitCommand}" CommandParameter="3"/>
                <Button Classes="key op" Content="+" Command="{Binding OperatorCommand}" CommandParameter="+"/>
                <Button Classes="key" Content="±" Command="{Binding NegateCommand}"/>
                <Button Classes="key" Content="0" Command="{Binding DigitCommand}" CommandParameter="0"/>
                <Button Classes="key" Content="," Command="{Binding DecimalCommand}"/>
                <Button Classes="key op" Content="=" Command="{Binding EqualsCommand}"/>
            </UniformGrid>
        </Viewbox>

        <!-- Historique : toucher un calcul réutilise son résultat -->
        <Border Grid.Row="1" Grid.RowSpan="3" Background="#1C1C1E" CornerRadius="14" Margin="10,4,10,14" IsVisible="{Binding ShowHistory}">
            <DockPanel>
                <Button DockPanel.Dock="Bottom" Classes="plain" HorizontalAlignment="Center" Margin="0,6,0,10" Foreground="#FF453A"
                        Content="Effacer l'historique" Command="{Binding ClearHistoryCommand}" IsEnabled="{Binding HasHistory}"/>
                <Panel>
                    <TextBlock Text="Il n'y a pas encore d'historique." FontSize="15" Foreground="#8E8E93" Margin="18"
                               HorizontalAlignment="Center" IsVisible="{Binding !HasHistory}"/>
                    <ScrollViewer>
                        <ItemsControl ItemsSource="{Binding History}" Margin="0,6">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Classes="mem" HorizontalContentAlignment="Right" Padding="18,8" Command="{Binding ReuseCommand}">
                                        <StackPanel HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding Expression}" FontSize="14" Foreground="#8E8E93" HorizontalAlignment="Right" FontWeight="Normal"/>
                                            <TextBlock Text="{Binding Result}" FontSize="26" FontWeight="Light" Foreground="White" HorizontalAlignment="Right"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Panel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
