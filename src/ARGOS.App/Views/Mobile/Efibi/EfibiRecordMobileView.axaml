<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m="using:Argos.Views.Mobile"
             x:Class="Argos.Views.Mobile.Efibi.EfibiRecordMobileView"
             Classes="ios"
             m:MobilePage.IsNative="True"
             m:MobilePage.Accent="#0B5394">
    <!-- Fiche bilan eFiBi sur iPhone (même modèle que la version bureau : EfibiRecordViewModel). -->
    <UserControl.Resources>
        <SolidColorBrush x:Key="AppAccent" Color="#0B5394"/>
        <CornerRadius x:Key="ControlCornerRadius">0</CornerRadius>
        <CornerRadius x:Key="OverlayCornerRadius">0</CornerRadius>
    </UserControl.Resources>

    <!-- Surcharge locale du style iOS commun : aucun arrondi dans eFiBi. -->
    <UserControl.Styles>
        <Style Selector=".ios Border.group, .ios Border.tile, .ios Border.searchbar, .ios Border.badge, .ios Border.banner, .ios Border.segments">
            <Setter Property="CornerRadius" Value="0"/>
        </Style>
        <Style Selector=".ios Border.group">
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="0,0.5"/>
        </Style>
        <Style Selector=".ios Button.primary, .ios Button.secondary, .ios Button.destructive, .ios Button.seg, .ios Button.row, .ios Button.plain">
            <Setter Property="CornerRadius" Value="0"/>
        </Style>
        <Style Selector=".ios TextBlock.section">
            <Setter Property="Foreground" Value="#0B5394"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12.5"/>
        </Style>
        <Style Selector=".ios TextBlock.flabel">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#6B7A89"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style Selector=".ios SelectableTextBlock.fvalue">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="#1C2733"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style Selector=".ios SelectableTextBlock.fvalue.empty">
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Foreground" Value="#A0ABB6"/>
            <Setter Property="FontStyle" Value="Italic"/>
        </Style>
        <Style Selector=".ios TextBlock.hlabel">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#6B7A89"/>
        </Style>
        <Style Selector=".ios SelectableTextBlock.hvalue">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#1C2733"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*">
        <Border Classes="banner" IsVisible="{Binding HasError}">
            <TextBlock Text="{Binding Error}"/>
        </Border>

        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,0,24">
                <!-- En-tête : n° d'intervention, code fiche, horodatage, auteur, statut -->
                <Border Background="#0B5394" Padding="16,12" Margin="0,0,0,0">
                    <StackPanel Spacing="2">
                        <TextBlock Text="FICHE BILAN" Foreground="#C9DCEE" FontSize="11" FontWeight="Bold"/>
                        <SelectableTextBlock Text="{Binding Intervention}" Foreground="White" FontSize="24" FontWeight="Bold" TextWrapping="Wrap"/>
                        <TextBlock Foreground="#C9DCEE" FontSize="12.5">
                            <Run Text="Fiche n° "/><Run Text="{Binding Id, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                </Border>
                <Border Background="White" BorderBrush="#D1D5DB" BorderThickness="0,0,0,0.5">
                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto">
                        <Border BorderBrush="#E5E5EA" BorderThickness="0,0,0.5,0.5" Padding="16,10">
                            <StackPanel Spacing="2">
                                <TextBlock Classes="hlabel" Text="CODE FICHE"/>
                                <SelectableTextBlock Classes="hvalue" Text="{Binding FicheCode}" FontFamily="Menlo, Consolas, DejaVu Sans Mono, monospace"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" BorderBrush="#E5E5EA" BorderThickness="0,0,0,0.5" Padding="16,10">
                            <StackPanel Spacing="2">
                                <TextBlock Classes="hlabel" Text="HORODATAGE"/>
                                <SelectableTextBlock Classes="hvalue" Text="{Binding DisplayDate}"/>
                                <TextBlock Text="{Binding DisplayTime}" FontSize="13" FontWeight="SemiBold" Foreground="#3C3C43"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="1" BorderBrush="#E5E5EA" BorderThickness="0,0,0.5,0" Padding="16,10">
                            <StackPanel Spacing="2">
                                <TextBlock Classes="hlabel" Text="AUTEUR"/>
                                <SelectableTextBlock Classes="hvalue" Text="{Binding Author}"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="1" Grid.Column="1" Padding="16,10">
                            <StackPanel Spacing="4">
                                <TextBlock Classes="hlabel" Text="STATUT"/>
                                <Border Background="{Binding StatusBrush}" Padding="8,4" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding Status}" Foreground="White" FontSize="12.5" FontWeight="Bold" TextWrapping="Wrap"/>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <Border Classes="group" Margin="16,12,16,0" IsVisible="{Binding Loading}">
                    <Border Classes="row">
                        <TextBlock Classes="value" Text="Chargement de la fiche…"/>
                    </Border>
                </Border>

                <StackPanel IsVisible="{Binding HasRecord}">
                    <!-- Synthèse -->
                    <TextBlock Classes="section" Text="SYNTHÈSE"/>
                    <Border Classes="group">
                        <StackPanel>
                            <Border Classes="row">
                                <StackPanel Spacing="2">
                                    <TextBlock Classes="flabel" Text="Victime"/>
                                    <SelectableTextBlock Classes="fvalue" Text="{Binding Victim}" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>
                            <Border Classes="row">
                                <StackPanel Spacing="2">
                                    <TextBlock Classes="flabel" Text="Bilan circonstanciel"/>
                                    <SelectableTextBlock Classes="fvalue" Text="{Binding Circumstances}"/>
                                </StackPanel>
                            </Border>
                            <Border Classes="row">
                                <StackPanel Spacing="2">
                                    <TextBlock Classes="flabel" Text="Identifiant FiveM du rédacteur"/>
                                    <SelectableTextBlock Classes="fvalue" Text="{Binding CitizenId}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Informations de transmission -->
                    <TextBlock Classes="section" Text="INFORMATIONS DE TRANSMISSION"/>
                    <Border Classes="group">
                        <StackPanel>
                            <Border Classes="row">
                                <StackPanel Spacing="2">
                                    <TextBlock Classes="flabel" Text="Statut"/>
                                    <SelectableTextBlock Classes="fvalue" Text="{Binding Status}" Foreground="{Binding StatusBrush}" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>
                            <Border Classes="row">
                                <StackPanel Spacing="2">
                                    <TextBlock Classes="flabel" Text="Date et heure de transmission"/>
                                    <SelectableTextBlock Classes="fvalue">
                                        <Run Text="{Binding TransmissionDate, Mode=OneWay}"/><Run Text=" "/><Run Text="{Binding TransmissionTime, Mode=OneWay}"/>
                                    </SelectableTextBlock>
                                </StackPanel>
                            </Border>
                            <Border Classes="row">
                                <StackPanel Spacing="2">
                                    <TextBlock Classes="flabel" Text="Prise en charge"/>
                                    <SelectableTextBlock Classes="fvalue" Text="{Binding Started}"/>
                                </StackPanel>
                            </Border>
                            <Border Classes="row">
                                <StackPanel Spacing="2">
                                    <TextBlock Classes="flabel" Text="Création de la fiche"/>
                                    <SelectableTextBlock Classes="fvalue" Text="{Binding Created}"/>
                                </StackPanel>
                            </Border>
                            <Border Classes="row">
                                <StackPanel Spacing="2">
                                    <TextBlock Classes="flabel" Text="Dernière mise à jour"/>
                                    <SelectableTextBlock Classes="fvalue" Text="{Binding Updated}"/>
                                </StackPanel>
                            </Border>
                            <Border Classes="row">
                                <StackPanel Spacing="2">
                                    <TextBlock Classes="flabel" Text="Code de partage"/>
                                    <SelectableTextBlock Classes="fvalue" Text="{Binding ShareCode}" FontFamily="Menlo, Consolas, DejaVu Sans Mono, monospace"/>
                                </StackPanel>
                            </Border>
                            <Border Classes="row">
                                <StackPanel Spacing="2">
                                    <TextBlock Classes="flabel" Text="Erreurs et historique"/>
                                    <SelectableTextBlock Classes="fvalue empty" Text="Non renseigné (absent de la base)"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Rubriques du bilan -->
                    <ItemsControl ItemsSource="{Binding Sections}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Classes="section" Text="{Binding Title}" TextWrapping="Wrap"/>
                                    <Border Classes="group">
                                        <StackPanel>
                                            <ItemsControl ItemsSource="{Binding Fields}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Classes="row">
                                                            <StackPanel Spacing="2">
                                                                <TextBlock Classes="flabel" Text="{Binding Label}"/>
                                                                <SelectableTextBlock Classes="fvalue" Classes.empty="{Binding IsEmpty}" Text="{Binding Value}"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <ItemsControl ItemsSource="{Binding Lists}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Classes="row">
                                                            <StackPanel Spacing="3">
                                                                <TextBlock Classes="flabel" Text="{Binding Name}"/>
                                                                <ItemsControl ItemsSource="{Binding Items}">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Grid ColumnDefinitions="16,*" Margin="0,1">
                                                                                <TextBlock Text="•" Foreground="#0B5394" FontWeight="Bold" FontSize="15"/>
                                                                                <SelectableTextBlock Grid.Column="1" Text="{Binding}" TextWrapping="Wrap" FontSize="15" Foreground="#1C2733"/>
                                                                            </Grid>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                                <TextBlock Text="Non renseigné" FontSize="13.5" FontStyle="Italic" Foreground="#A0ABB6"
                                                                           IsVisible="{Binding !Items.Count}"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Classes="footnote" Text="Aucune rubrique n'est enregistrée dans cette fiche." IsVisible="{Binding HasNoSections}"/>

                    <TextBlock Classes="footnote" Margin="32,14,16,0">
                        <Run Text="Source : base eFiBi · Code fiche "/><Run Text="{Binding FicheCode, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
