<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Charte ADAGIO (prise d'appel vLife) : fond bleu acier, champs bleu pâle, cadres blancs arrondis,
        police Arial. Utilisée par la prise d'appel et toute l'application ADAGIO ODE.
    -->
    <Styles.Resources>
        <FontFamily x:Key="AdagioFont">Arial, Helvetica, Liberation Sans</FontFamily>
        <SolidColorBrush x:Key="AdagioBack" Color="#AFCADB"/>
        <SolidColorBrush x:Key="AdagioField" Color="#D7E4EC"/>
        <SolidColorBrush x:Key="AdagioFieldHover" Color="#E4EDF3"/>
        <SolidColorBrush x:Key="AdagioFrame" Color="#F0F0F0"/>
        <SolidColorBrush x:Key="AdagioYellow" Color="#F9F8C4"/>
        <SolidColorBrush x:Key="AdagioGreen" Color="#B1FCA3"/>
        <SolidColorBrush x:Key="AdagioPlaceholder" Color="#A0A0A0"/>
        <SolidColorBrush x:Key="AdagioMenu" Color="#F0F0F0"/>
        <StreamGeometry x:Key="AdagioArrow">M0,0 L10,0 L5,6 Z</StreamGeometry>
        <StreamGeometry x:Key="AdagioCheck">M9,16.17L4.83,12L3.41,13.41L9,19L21,7L19.59,5.59L9,16.17Z</StreamGeometry>
    </Styles.Resources>

    <!-- ===== Cadre à titre (GroupBox Windows) ===== -->
    <Style Selector="HeaderedContentControl.group">
        <Setter Property="Margin" Value="6,2,6,4"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Grid RowDefinitions="Auto,*">
                    <Border Grid.Row="0" Grid.RowSpan="2" Margin="0,12,0,0"
                            BorderBrush="{StaticResource AdagioFrame}" BorderThickness="2.5" CornerRadius="6"/>
                    <Border Grid.Row="0" HorizontalAlignment="Left" Margin="10,0,0,0" Padding="4,0,6,0"
                            Background="{StaticResource AdagioBack}">
                        <ContentPresenter Content="{TemplateBinding Header}"
                                          TextElement.FontSize="15" TextElement.FontWeight="Bold"/>
                    </Border>
                    <ContentPresenter Grid.Row="1" Content="{TemplateBinding Content}" Margin="10,2,10,8"/>
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- Libellés : gras, petits -->
    <Style Selector="TextBlock.lbl">
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="TextBlock.cap">
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Margin" Value="2,0,0,2"/>
    </Style>

    <!-- ===== Champs ===== -->
    <Style Selector="TextBox.adg">
        <Setter Property="Background" Value="{StaticResource AdagioField}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="1"/>
        <Setter Property="FontFamily" Value="{StaticResource AdagioFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="Black"/>
        <Setter Property="MinHeight" Value="22"/>
        <Setter Property="Padding" Value="5,2"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="TextBox.adg:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{StaticResource AdagioFieldHover}"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="TextBox.adg:focus /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="#5D8CB5"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style Selector="TextBox.adg.center">
        <Setter Property="TextAlignment" Value="Center"/>
    </Style>
    <Style Selector="TextBox.adg.yellow">
        <Setter Property="Background" Value="{StaticResource AdagioYellow}"/>
    </Style>
    <Style Selector="TextBox.adg.yellow:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{StaticResource AdagioYellow}"/>
    </Style>
    <Style Selector="TextBox.adg.yellow:focus /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="#FCFBDD"/>
    </Style>

    <!-- Valeur affichée (non modifiable), centrée sur fond bleu pâle -->
    <Style Selector="Border.val">
        <Setter Property="Background" Value="{StaticResource AdagioField}"/>
        <Setter Property="MinHeight" Value="22"/>
        <Setter Property="Padding" Value="5,2"/>
    </Style>
    <Style Selector="Border.val > TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style Selector="Border.val.green">
        <Setter Property="Background" Value="{StaticResource AdagioGreen}"/>
    </Style>

    <!-- Listes déroulantes plates, flèche noire -->
    <Style Selector="ComboBox.adg">
        <Setter Property="Background" Value="{StaticResource AdagioField}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="1"/>
        <Setter Property="FontFamily" Value="{StaticResource AdagioFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="Black"/>
        <Setter Property="MinHeight" Value="22"/>
        <Setter Property="Padding" Value="5,1"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
    </Style>
    <Style Selector="ComboBox.adg.bold">
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="14"/>
    </Style>
    <Style Selector="ComboBox.adg:pointerover /template/ Border#Background">
        <Setter Property="Background" Value="{StaticResource AdagioFieldHover}"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="ComboBox.adg /template/ PathIcon#DropDownGlyph">
        <Setter Property="Foreground" Value="Black"/>
    </Style>

    <!-- Saisie avec suggestions (voie, motif de l'alerte) -->
    <Style Selector="AutoCompleteBox.adg">
        <Setter Property="Background" Value="{StaticResource AdagioField}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontFamily" Value="{StaticResource AdagioFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="Black"/>
        <Setter Property="MinHeight" Value="22"/>
        <Setter Property="FilterMode" Value="Contains"/>
        <Setter Property="MinimumPrefixLength" Value="0"/>
        <Setter Property="MaxDropDownHeight" Value="320"/>
    </Style>
    <Style Selector="AutoCompleteBox.adg /template/ TextBox#PART_TextBox">
        <Setter Property="Background" Value="{StaticResource AdagioField}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="Black"/>
        <Setter Property="CornerRadius" Value="1"/>
    </Style>
    <Style Selector="AutoCompleteBox.adg.big">
        <Setter Property="FontSize" Value="19"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <!-- ===== Boutons ADAGIO ===== -->
    <Style Selector="Button.adg">
        <Setter Property="Background" Value="#F0F0F0"/>
        <Setter Property="BorderBrush" Value="#8FA9BC"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="Black"/>
        <Setter Property="FontFamily" Value="{StaticResource AdagioFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Padding" Value="12,5"/>
        <Setter Property="CornerRadius" Value="2"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.adg:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#FFFFFF"/>
        <Setter Property="BorderBrush" Value="#5D8CB5"/>
        <Setter Property="Foreground" Value="Black"/>
    </Style>
    <Style Selector="Button.adg.primary">
        <Setter Property="Background" Value="#2C6FB7"/>
        <Setter Property="BorderBrush" Value="#1D5694"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style Selector="Button.adg.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#3A80CA"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style Selector="Button.adg.danger">
        <Setter Property="Background" Value="#C9302C"/>
        <Setter Property="BorderBrush" Value="#A12622"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style Selector="Button.adg.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#DA3E39"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>

    <!-- Touches F1 à F9 : gros boutons colorés, texte noir gras sur deux lignes -->
    <Style Selector="Button.fkey">
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Margin" Value="3,0"/>
        <Setter Property="Padding" Value="2"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="Black"/>
        <Setter Property="FontFamily" Value="Arial Black, Arial, Helvetica"/>
        <Setter Property="FontWeight" Value="Black"/>
        <Setter Property="FontSize" Value="17"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <!-- Les touches utilisent le gabarit « flat » (Border#Root) : leur couleur ne change pas au survol. -->
    <Style Selector="Button.fkey:pointerover /template/ Border#Root">
        <Setter Property="Opacity" Value="0.82"/>
    </Style>
    <Style Selector="Button.fkey:disabled /template/ Border#Root">
        <Setter Property="Opacity" Value="0.45"/>
    </Style>
    <Style Selector="Button.fkey:pressed">
        <Setter Property="RenderTransform" Value="scale(0.97)"/>
    </Style>

    <!-- Bouton « Confirmer localisation » -->
    <Style Selector="Button.confirm">
        <Setter Property="Background" Value="#F0F0F0"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="2"/>
        <Setter Property="Padding" Value="4,3,10,3"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.confirm:pointerover /template/ Border#Root">
        <Setter Property="Background" Value="White"/>
    </Style>

    <!-- Menu en haut de fenêtre -->
    <Style Selector="Menu.adg">
        <Setter Property="Background" Value="{StaticResource AdagioMenu}"/>
        <Setter Property="FontFamily" Value="Segoe UI, Helvetica Neue, Arial"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Height" Value="26"/>
    </Style>
    <Style Selector="Menu.adg > MenuItem">
        <Setter Property="Padding" Value="9,3"/>
        <Setter Property="Foreground" Value="Black"/>
    </Style>

    <!-- ===== Listes de l'application ADAGIO ODE ===== -->
    <Style Selector="Border.tablehead">
        <Setter Property="Background" Value="#5D86A6"/>
        <Setter Property="Padding" Value="6,5"/>
    </Style>
    <Style Selector="Border.tablehead TextBlock">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style Selector="Button.row">
        <Setter Property="Background" Value="#E9F0F5"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="BorderBrush" Value="#C3D4E1"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="Padding" Value="6,5"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Foreground" Value="Black"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.row:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="White"/>
        <Setter Property="Foreground" Value="Black"/>
    </Style>

    <!-- Navigation de l'application ODE -->
    <Style Selector="Button.nav">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Padding" Value="14,9"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.nav:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#2B4F6E"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style Selector="Button.nav.selected">
        <Setter Property="Background" Value="#AFCADB"/>
        <Setter Property="Foreground" Value="Black"/>
    </Style>
    <Style Selector="Button.nav.selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#C3D8E6"/>
        <Setter Property="Foreground" Value="Black"/>
    </Style>

    <!-- Tuile de compteur du tableau de bord -->
    <Style Selector="Border.tile">
        <Setter Property="Background" Value="#E9F0F5"/>
        <Setter Property="BorderBrush" Value="White"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="Margin" Value="0,0,8,8"/>
        <Setter Property="MinWidth" Value="140"/>
    </Style>
</Styles>
