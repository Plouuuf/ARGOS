<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Cœur commun d'ARGOS : écrans de verrouillage et de connexion, bureau Windows 10, vue mobile,
    connexion Discord et temps réel.
    Utilisé par :
      ARGOS.Desktop (Windows + macOS)
      ARGOS.iOS     (iPhone et iPad)
      ARGOS.Android (téléphones et tablettes Android)
  -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyName>ARGOS.App</AssemblyName>
    <RootNamespace>Argos</RootNamespace>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="$(AvaloniaVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ARGOS.Shared\ARGOS.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <!-- Adresse du serveur par défaut, intégrée à l'application (toutes plateformes). -->
    <EmbeddedResource Include="client.defaults.json" LogicalName="ARGOS.client.defaults.json" />
  </ItemGroup>
</Project>
